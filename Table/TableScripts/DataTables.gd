        "技能#女仆长#影缝": [8104, "影缝", "影缝", "响应", "普通", "None", "（持有【风穴】的目标对手回合开始时发动，移除X点【糸】，X<4）他弃X张牌，你观看并将其中1张弃牌面朝下放置在你角色旁作为【影】；（若因此弃牌数小于X）对方士气-1。", [], []],
        "技能#女仆长#侍奉之道": [8105, "侍奉之道", "侍奉之道", "响应", "普通", "None", "（你的回合结束时发动，移除2个【影】【展示】）你+1【糸】；（若移除的【影】系别相同）将其中1个【影】交给目标角色【强制】，然后你【横置】【持续】。", [], []],
        "技能#女仆长#禁术·影牢": [8106, "禁术·影牢", "禁术·影牢", "响应", "普通", "None", "（其他角色【特殊行动】结束时发动）你+1【糸】；（若你已【横置】，额外移除3点【糸】）【重置】，对目标对手造成2点法术伤害③或指定目标队友弃1张牌。", [], []],
        "技能#女仆长#风穴": [8107, "风穴", "风穴", "被动", "专属技", "None", "【被动】影之风； （若你拥有【风穴】，当你主动攻击命中的攻击牌置入弃牌堆时）将该牌面朝下放置在女仆长角色旁作为【影】。 （你每次【攻击行动】结束时）女仆长+1【糸】。 【响应】风止； （若你拥有【风穴】，你的回合结束时发动）将手牌补到上限【强制】，弃2张牌，将弃牌面朝下放置在女仆长角色旁作为【影】，然后移除【风穴】。", [], []],
        "技能#女仆长#真·摹影": [8108, "真·摹影", "真·摹影", "启动", "必杀技", "Gem", "【宝石】将2张手牌面朝下放置在你角色旁作为【影】。", [], []],
        "技能#结界师#结界仪式": [8201, "结界仪式", "结界仪式", "法术", "普通", "None", "（将2张手牌面朝上放置在你角色旁【展示】作为【结界】）你+1【祭】。", [], []],
        "技能#结界师#荒神之力": [8202, "荒神之力", "荒神之力", "被动", "普通", "None", "（当【结界】在场时）所有与【结界】系别相同的攻击伤害额外+1。", [], []],
        "技能#结界师#荒神祭仪": [8203, "荒神祭仪", "荒神祭仪", "响应", "普通", "None", "（目标角色主动攻击时①，若攻击的系别与【结界】相同）你+1【祭】；（若你额外移除3点【祭】）你弃1张牌，移除1个【结界】并【横置】【持续】。", [[""], ["是否额外移除 3 点【祭】？发动后你弃 1 张牌，移除 1 个【结界】并【横置】"]], []],
        "技能#结界师#禁魔境": [8204, "禁魔境", "禁魔境", "法术", "普通", "None", "（移除1点【祭】）将【绝界】转移或放置在目标角色前，你弃1张牌。", [[""], ["【禁魔境】：弃 1 张牌"]], []],
