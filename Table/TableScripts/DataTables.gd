        "技能#散华轮舞": [3406, "散华轮舞", "散华轮舞", "启动", "必杀技", "None", "你选择以下一项发动：\\n　●【水晶】将【血蔷薇庭院】放置于场上，你+2【鲜血】。\\n　●【宝石】将【血蔷薇庭院】放置于场上，无视你的【鲜血】上限为你+2【鲜血】，但你的【鲜血】数最高为4，你弃到4张牌。", [["-1【水晶】将【血蔷薇庭院】放置于场上"], ["你+2【鲜血】"], [""], ["无视你的【鲜血】上限为你+2【鲜血】，但你的【鲜血】数最高为4，你弃到4张牌"]], [["-1【水晶】将【血蔷薇庭院】放置于场上"], ["-1【宝石】将【血蔷薇庭院】放置于场上"]]],
        "技能#新月庇护": [3501, "新月庇护【持续】", "新月庇护", "响应", "普通", "None", "（我方角色因承受伤害造成手牌数超过手牌上限，导致士气即将下降时）【横置】转为【暗月形态】，将因此而造成的弃牌面朝下放置于角色旁，作为【暗月】。本次士气不会下降。", [], []],
        "技能#暗月诅咒": [3502, "暗月诅咒", "暗月诅咒", "被动", "普通", "None", "（你每次移除【暗月】）我方士气-1；（你的【暗月】数为0时）【重置】脱离【暗月形态】。", [], []],
        "技能#美杜莎之眼": [3503, "美杜莎之眼", "美杜莎之眼", "响应", "普通", "None", "（目标对手攻击时①，移除1个与攻击牌相同系别的【暗月】【展示】）你+1【治疗】，+1【石化】。（若该【暗月】为法术牌）你弃1张牌，对目标对手造成1点法术伤害③。", [["发动【美杜莎之眼】：移除{n}张【盖牌】并选目标"]], [["移除 1 个【暗月】，+1【治疗】、+1【石化】"], ["移除 1 个法术牌【暗月】并弃 1 张手牌，+1【治疗】、+1【石化】，对目标对手造成 1 点法术伤害"]]],
        "技能#月之轮回": [3504, "月之轮回", "月之轮回", "响应", "普通", "None", "（你的回合结束时）选择以下一项发动：\\n　●（移除1个【暗月】）目标角色+1【治疗】。\\n　●（移除你的1【治疗】）你+1【新月】。", [["发动【月之轮回】：弃{n}张【盖牌】并选目标"]], [["移除 1 张【暗月】：指定角色 +1【治疗】"], ["耗 1 点【治疗】：+1【新月】指示物"]]],
        "技能#月渎": [3505, "月渎【回合限定】", "月渎", "响应", "普通", "None", "（目标角色承受你造成的法术伤害⑥后，移除你的1【治疗】）对目标对手造成1点法术伤害③。", [["发动【月渎】：耗1点【治疗】对目标造成1点伤害"]], []],
        "技能#暗月斩": [3506, "暗月斩", "暗月斩", "响应", "必杀技", "Crystal", "【水晶】（仅【暗月形态】下可发动，主动攻击命中时②，一次移除X个【暗月】(X<3)）本次攻击伤害额外+X。", [["发动【暗月斩】：移除{n}个【暗月】"]], []],
        "技能#苍白之月": [3507, "苍白之月", "苍白之月", "法术", "必杀技", "Gem", "【宝石】选择以下一项发动：\\n　●（移除3点【石化】）你的下次主动攻击对手无法应战，额外+1【攻击行动】。你额外获得一个回合。\\n　●移除X点【新月】，你+1【石化】，弃1张牌，对目标对手造成(X+1)点法术伤害③。", [], [["移除3点【石化】+1无法应战【攻击行动】。+1回合。"], ["移除X点【新月】+1【石化】，弃 1 张牌。对目标对手造成 X+1点法术伤害。"], ["移除 %d 点【新月】"]]],
        "技能#天之弓": [3701, "天之弓", "天之弓", "被动", "普通", "None", "游戏初始时，你+2【水晶】，+1【圣煌辉光炮】。你的【治疗】上限+1。（主动攻击时①，若该次攻击不为圣类命格）本次攻击伤害-1；（主动攻击命中时②，若该次攻击为圣类命格）你+1【信仰】。", [], []],
        "技能#圣屑飓暴": [3702, "圣屑飓暴", "圣屑飓暴", "法术", "普通", "None", "（弃2张同系攻击牌【展示】）视为一次圣类命格的该系主动攻击；（若攻击未命中②，移除你的X【治疗】，X最高为2）目标队友弃X张牌。", [["请选择{n}张【手牌】弃掉"], ["发动【圣屑飓暴】：指定1名队友弃X张牌"]], [["目标友方弃 %d 张牌"]]],
        "技能#圣煌模式": [3703, "圣煌降临", "圣煌降临", "法术", "普通", "None", "（移除你的2【治疗】或2点【信仰】）【横置】转为【圣煌形态】，额外+1【法术行动】。此形态下你若执行【特殊行动】，则【重置】脱离【圣煌形态】并+1【治疗】或+1【信仰】。", [], [["移除 2【治疗】"], ["移除 2 点【信仰】"], ["+1【治疗】"], ["+1【信仰】"]]],
        "技能#圣光爆裂": [3704, "圣光爆裂", "圣光爆裂", "法术", "普通", "None", "（仅【圣煌形态】下可发动）你选择以下一项发动：\\n　●摸1张牌【强制】，移除你的1【治疗】，你+1【信仰】，目标队友+1【治疗】。\\n　●（移除你的X【治疗】，选择最多X名手牌数不大于你手牌数-X的对手）你弃X张牌，然后对他们各造成(Y+2)点攻击伤害③，Y为目标中拥有【治疗】的人数。", [], [["摸 1 张牌，移除 1 治疗，目标队友 +1 治疗"], ["移除 X 治疗，弃 X 牌，群体攻击"], ["移除 %d 治疗，弃 %d 张牌，最多 %d 名目标"]]],
        "技能#圣流星弹": [3705, "流星圣弹", "流星圣弹", "响应", "普通", "None", "（仅【圣煌形态】下，主动攻击前①，移除你的1【治疗】或1点【信仰】）我方目标角色+1【治疗】。", [["发动【圣流星弹】：令目标+1【治疗】"]], [["移除 1 点【治疗】，令目标 +1【治疗】"], ["移除 1 点【信仰】，令目标 +1【治疗】"]]],
        "技能#圣煌辉光炮": [3706, "圣煌辉光炮", "圣煌辉光炮", "法术", "专属技", "None", "（仅【圣煌形态】下可发动，移除1点【圣煌辉光炮】，移除4点【信仰】，并额外移除等同我方落后【士气】的【信仰】数）所有角色将手牌调整为4张，我方【星杯区】+1【星杯】，然后将一方【士气】调整与另一方相同。", [["请选择{n}张【手牌】弃掉"]], [["我方【士气】调整至与敌方相同"], ["敌方【士气】调整至与我方相同"]]],
        "技能#圣煌余辉": [3708, "圣煌余辉", "圣煌余辉", "法术", "专属技", "None", "（仅【圣煌形态】下发动，移除4点【信仰】，然后移除等同我方落后【士气】的【信仰】数）所有角色将手牌调整为4张，我方【星杯区】+1【星杯】，将一方【士气】调整与另一方相同，然后移除【圣煌余辉】。", [["请选择{n}张【手牌】弃掉"]], []],
        "技能#自动填充": [3707, "自动填充", "自动填充", "被动", "必杀技", "None", "（你的回合结束时，若你未执行【特殊行动】）你选择以下一项发动：\\n　●【水晶】你+1【信仰】或+1【治疗】。\\n　●【宝石】你+1【水晶】，+2【信仰】或+2【治疗】。", [["发动【自动填充】：选择转化的【能量】"]], [["-1【水晶】，+1【信仰】或 +1【治疗】"], ["-1【宝石】，+1【水晶】，+2【信仰】或 +2【治疗】"], ["+1【水晶】，+2【信仰】"], ["+1【水晶】，+2【治疗】"], ["+1【信仰】"], ["+1【治疗】"]]],
        "技能#欺诈Trick": [8901, "欺诈", "欺诈", "响应", "普通", "None", "(弃2张同系牌【展示】)视为一次除暗系以外的任意系的主动攻击，该系由你决定。", [], [["视为%s"]]],
        "技能#冒险者天堂Trick": [8902, "冒险者天堂", "冒险者天堂", "响应", "普通", "None", "(你执行【提炼】时，移除自身X【能量】)额外提炼X【水晶】，然后将全部提炼出的【宝石】和【水晶】分配给至多2名目标队友。", [["选择提炼方式"]], [["给自己提炼 1~2 个"], ["给队友额外提炼 {n} 颗（{花费}）"]]],
        "技能#偷天换日Trick": [8903, "偷天换日【回合限定】", "偷天换日", "法术", "必杀技", "Crystal", "【水晶】将对方【战绩区】的1【宝石】转移到我方【战绩区】，或将我方【战绩区】的【水晶】全部转换为【宝石】，额外+1【攻击行动】或【法术行动】。", [["发动【偷天换日】：转移对方1个【宝石】，或把我方【战绩区】的【水晶】全部转为【宝石】"]], [["转移对方 1【宝石】到我方战绩区"], ["我方【水晶】全部转为【宝石】"]]],
        "技能#强运Trick": [8905, "强运", "强运", "被动", "普通", "None", "(当你发动【欺诈】时)你+1【水晶】。", [], []],
        "技能#地下法则Trick": [8906, "地下法则", "地下法则", "被动", "普通", "None", "你执行【购买】时，改为【战绩区】+2【宝石】。", [], []],
        "技能#天之弓Trick": [8801, "天之弓", "天之弓", "被动", "普通", "None", "游戏初始时，你拥有【圣煌辉光炮】，你的【治疗】上限+1。（主动攻击时①，若该次攻击不为圣类命格）本次攻击伤害-1；（攻击命中时②，若该次攻击为圣类命格）你+1【信仰】。", [], []],
        "技能#圣屑飓暴Trick": [8802, "圣屑飓暴", "圣屑飓暴", "法术", "普通", "None", "（弃2张同系牌【展示】）视为一次圣类命格的该系主动攻击；（若该弃牌为【圣光】）则视为一次圣类命格的暗系主动攻击；（若攻击未命中②，移除你的X【治疗】，X最高为2）目标队友弃X张牌。", [["请选择{n}张【手牌】弃掉"], ["发动【圣屑飓暴】：指定1名队友弃X张牌"]], [["目标友方弃 %d 张牌"]]],
        "技能#圣煌模式Trick": [8803, "圣煌降临【持续】", "圣煌降临", "法术", "普通", "None", "（移除你的2【治疗】或2点【信仰】）【横置】转为【圣煌形态】，额外+1【法术行动】。此形态下，你若执行【特殊行动】，则【重置】脱离【圣煌形态】并+1【治疗】。", [], [["移除 2【治疗】"], ["移除 2 点【信仰】"]]],
        "技能#圣光爆裂Trick": [8804, "圣光爆裂", "圣光爆裂", "法术", "普通", "None", "（仅【圣煌形态】下可发动）你选择以下一项发动：\\n　●（移除你的1【治疗】）摸1张牌【强制】，对手牌数小于你的目标对手造成2点攻击伤害③，你+1【信仰】。\\n　●（移除你的X【治疗】，选择最多X名手牌数不大于你手牌数-X的对手）你弃X张牌，然后对他们各造成(Y+2)点攻击伤害③，Y为目标中拥有【治疗】的人数，你+X【信仰】。", [], [["发动单体攻击，移除 1 治疗，摸 1 牌"], ["发动群体攻击，移除 X 治疗，弃 X 牌"], ["移除 %d 治疗，弃 %d 张牌，最多 %d 名目标"]]],
        "技能#圣流星弹Trick": [8805, "流星圣弹", "流星圣弹", "响应", "普通", "None", "（仅【圣煌形态】下，主动攻击前①，移除你的1【治疗】或1点【信仰】）我方目标角色+1【治疗】。", [["发动【圣流星弹】：令目标+1【治疗】"]], [["移除 1 点【治疗】，令目标 +1【治疗】"], ["移除 1 点【信仰】，令目标 +1【治疗】"]]],
        "技能#圣煌辉光炮Trick": [8806, "圣煌辉光炮", "圣煌辉光炮", "法术", "专属技", "None", "（仅【圣煌形态】下可发动，移除4点【信仰】，然后移除等同我方落后【士气】的【信仰】数）所有角色将手牌调整为4张，我方【星杯区】+1【星杯】，然后将一方【士气】调整与另一方相同，我方所有角色各+1【治疗】，你额外+1【攻击行动】或【法术行动】并将【圣煌辉光炮】翻面。", [["请选择{n}张【手牌】弃掉"]], [["我方【士气】调整至与敌方相同"], ["敌方【士气】调整至与我方相同"]]],
        "技能#圣煌余辉Trick": [8808, "圣煌余辉", "圣煌余辉", "法术", "专属技", "None", "（仅【圣煌形态】下发动，移除4点【信仰】，然后移除等同我方落后【士气】的【信仰】数）所有角色将手牌调整为4张，我方【星杯区】+1【星杯】，将一方【士气】调整与另一方相同，然后移除【圣煌余辉】。", [["请选择{n}张【手牌】弃掉"]], [["我方【士气】调整至与敌方相同"], ["敌方【士气】调整至与我方相同"]]],
        "技能#自动填充Trick": [8807, "自动填充", "自动填充", "被动", "必杀技", "None", "（你的回合结束时，若你未执行【特殊行动】）你选择以下一项发动：\\n　●【水晶】（无则用【宝石】）你+1【治疗】或 +1【信仰】。\\n　●【宝石】你+1【水晶】，+2【治疗】或 +2【信仰】。", [["发动【自动填充】：选择转化的【能量】"]], [["-1【水晶】，+1【治疗】或 +1【信仰】"], ["-1【宝石】，+1【水晶】，+2【治疗】或 +2【信仰】"], ["+1【水晶】，+2【信仰】"], ["+1【水晶】，+2【治疗】"], ["+1【信仰】"], ["+1【治疗】"]]],
        "技能#转换": [4201, "转换", "转换", "响应", "普通", "None", "除【圣光】外，你的法术牌都可作为对应系别攻击牌使用。", [], []],
        "技能#狩魔刺": [4202, "狩魔刺", "狩魔刺", "响应", "普通", "None", "（主动攻击手牌<4的目标对手时①，该目标弃1张牌【展示】）将弃牌面朝下放置于你的角色旁，作为【魔力瓶】。", [["请选择 1 张手牌弃掉"]], []],
        "技能#法术剥离": [4203, "法术剥离", "法术剥离", "响应", "普通", "None", "（主动攻击命中时②发动）目标角色弃1张牌，将弃牌面朝下放置于你的角色旁，作为【魔力瓶】。", [["请选择 1 张手牌弃掉"]], []],
        "技能#灌银毒刃": [4204, "灌银毒刃", "灌银毒刃", "响应", "普通", "None", "（目标角色承受你造成的伤害时⑥发动，移除1个【魔力瓶】）本次伤害-1，将移除的【魔力瓶】加入他手牌【强制】，你+1【治疗】。", [], []],
        "技能#偷袭": [4205, "偷袭【回合限定】", "偷袭", "响应", "必杀技", "Crystal", "【水晶】（【攻击行动】结束时，移除2个【魔力瓶】【展示】）每有X张法术牌，对X名目标对手造成1点法术伤害③；（若有2张攻击牌）额外+1【攻击行动】。（若为同系牌）对目标角色造成1点法术伤害③。", [[""], ["对{n}名目标对手造成1点法术伤害。"], ["对目标角色造成1点法术伤害。"]], []],
        "技能#游击士#精灵赠礼": [3801, "精灵赠礼", "精灵赠礼", "被动", "普通", "None", "游戏初始时， 将牌库顶6张牌牌面朝下放置于你的角色旁，作为【子弹】。", [], []],
        "技能#游击士#元素射击*索拉": [3802, "元素射击*索拉", "元素射击*索拉", "响应", "普通", "None", "（主动攻击时①，移除1个子弹）根据【子弹】系别附加以下效果：\\n　●【火系】：本次攻击伤害额外+1。\\n　●【水系】：（主动攻击命中时②）目标角色+1【治疗】。\\n　●【风系】：（【攻击行动】结束后）额外+1【攻击行动】。\\n　●【雷系】：本次攻击无法应战。\\n　●【地系】：（主动攻击命中时②）对目标角色造成1点法术伤害③。\\n　●【光系或暗系】：视为任一系别的【子弹】。", [["发动【元素射击】：移除 1 个【子弹】"], ["【光/暗系】子弹：选择视为的系别"], ["选择 1 名角色获得 1【治疗】"], ["选择 1 名角色承受 1 点法术伤害"]], [["视为%s系"]]],
        "技能#游击士#二重剑影": [3803, "二重剑影【回合限定】", "二重剑影", "响应", "普通", "None", "（【攻击行动】结束时，若本次攻击命中②）额外加1系别相同的【攻击行动】。", [], []],
        "技能#游击士#附魔之术": [3804, "附魔之术", "附魔之术", "响应", "普通", "None", "（你执行【提炼】时，若你未拥有【子弹】）消耗你提炼的1能量，将1张手牌面朝下置于你的角色旁，作为【子弹】。", [["发动【附魔之术】：消耗提炼的 1 能量，将 1 张手牌面朝下作为【子弹】"]], []],
        "技能#游击士#精灵的剑舞": [3805, "精灵的剑舞", "精灵的剑舞", "响应", "必杀技", "Crystal", "【水晶】（主动攻击前①）本次你的攻击牌系别视为风系。", [], []],
