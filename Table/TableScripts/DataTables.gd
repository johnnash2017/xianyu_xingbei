        "技能#矜贵之女#魔法入门": [7802, "魔法入门", "魔法入门", "法术", "普通", "None", "你摸1张牌【强制】【展示】，根据所展示的牌依序触发相应效果：（若有法术牌）对2名目标对手各造成1点法术伤害③，（若有X张咏类命格）你对X名目标角色各造成1点法术伤害③，（若有X张水系牌）指定X名目标角色各+1【治疗】。", [["【魔法入门】：对 2 名目标对手造成 1 点法术伤害"], ["【魔法入门】：对 {n} 名目标各造成 1 点法术伤害"], ["【魔法入门】：指定 {n} 名目标角色各 +1【治疗】"]], [["你摸 1 张牌【强制】"], ["-1【宝石】改为我方 2 名角色各弃 1 张牌【强制】，技能效果结束前各摸 1 张牌【强制】"]]],
        "技能#矜贵之女#Magic!": [7803, "Magic!", "Magic!", "响应", "普通", "None", "（【魔法入门】展示牌触发效果时发动）你弃2张牌；（【魔法入门】展示牌未触发任何效果时发动）你额外+1【法术行动】。 （本回合第3次【魔法入门】结算时发动）我方【战绩区】+2【宝石】。", [["发动【Magic!】：展示牌触发效果时弃 2 张牌，未触发时额外 +1【法术行动】"], ["本回合第 3 次【魔法入门】：发动【Magic!】使我方战绩区 +2【宝石】"]], [["弃 2 张牌"], ["额外+1【法术行动】"], ["我方【战绩区】+2【宝石】"]]],
        "技能#矜贵之女#强予愿行": [7804, "强予愿行", "强予愿行", "启动", "必杀技", "Crystal", "【水晶】将你的手牌调整为4张【强制】；（若你额外移除我方【战绩区】1星石）将一名其他角色手牌调整为4张【强制】。", [["发动【强予愿行】：是否额外移除战绩区 1 颗星石"], ["选择 1 名其他角色，将其手牌调整为 4 张"]], [["仅调整自己手牌为 4"], ["【战绩区】-1【水晶】调整其他角色手牌为 4"], ["【战绩区】-1【宝石】调整其他角色手牌为 4"]]],
        "技能#矜贵之女#友情羁绊": [7805, "友情羁绊【回合限定】", "友情羁绊", "响应", "必杀技", "Gem", "【宝石】（发动【魔法入门】时发动）将“你摸1张牌【强制】【展示】”改为“我方2名角色各弃1张牌【强制】【展示】，技能效果结束前各摸1张牌【强制】”。", [["发动【友情羁绊】：选择 2 名我方角色各弃 1 张牌【展示】"]], []],
        "技能#噬神者#御刃": [7901, "御刃", "御刃", "启动", "普通", "None", "（当【魔刃】或【异刃】未在场时）将【魔刃】或【异刃】加入你手牌【强制】。", [], [["【%s】%s加入手牌"]]],
        "技能#噬神者#侵刻": [7902, "侵刻", "侵刻", "响应", "普通", "None", "（使用【魔刃】或【异刃】攻击命中时发动②）将该卡加入攻击目标手牌【强制】。", [], []],
        "技能#噬神者#噬灭": [7903, "噬灭", "噬灭", "响应", "普通", "None", "（当你使用【魔刃】对目标角色攻击时发动①，额外弃1张水系或火系牌【展示】）移除该攻击目标1【治疗】。", [], []],
        "技能#噬神者#殇灭": [7904, "殇灭", "殇灭", "响应", "普通", "None", "（当你使用【异刃】对目标角色攻击时发动①，额外弃1张风系或雷系牌【展示】）移除该攻击目标外1名敌方角色1【治疗】。", [], []],
        "技能#噬神者#同调": [7905, "同调", "同调", "被动", "普通", "None", "（你触发【渗蚀】时）3点法术伤害变更为1点法术伤害。", [], [["不加入手牌"], ["【魔刃】%s加入手牌"], ["【异刃】%s加入手牌"], ["【魔刃】%s和【异刃】%s加入手牌"]]],
        "技能#噬神者#魔刃": [7909, "魔刃", "魔刃", "被动", "专属技", "None", "（此卡视为手牌，若你拥有【魔刃】，使用、打出或弃置【魔刃】时）你选择此卡视为火系或水系的血类命格攻击牌。", [], []],
        "技能#噬神者#异刃": [7910, "异刃", "异刃", "被动", "专属技", "None", "（此卡视为手牌，若你拥有【异刃】，使用、打出或弃置【异刃】时）你选择此卡视为雷系或风系的血类命格攻击牌。", [], []],
        "技能#噬神者#渗蚀": [7911, "渗蚀", "渗蚀", "被动", "专属技", "None", "（若你拥有【魔刃】或【异刃】，使用、打出或弃置该牌时）噬神者对该牌的使用者造成3点法术伤害③，然后移除该牌。（该牌因技能放置在角色旁时）对该角色造成1点法术伤害③，然后移除该牌。", [], []],
        "技能#噬神者#共振": [7907, "共振", "共振", "响应", "必杀技", "Crystal", "【水晶】（任何人对你造成法术伤害时发动③，选择2-3张同系牌）弃置之【展示】；（若你额外将未在场的【魔刃】和/或【异刃】加入你手牌【强制】）对目标角色造成1点法术伤害③。", [], []],
        "技能#噬神者#诸神终焉": [7908, "诸神终焉", "诸神终焉", "法术", "必杀技", "Gem", "【宝石】你+1【水晶】，对自己造成2点法术伤害③，将场上的【魔刃】和【异刃】同时移除，然后对原持有【魔刃】和【异刃】的目标角色各造成3点法术伤害③；（若以此法同时移除【魔刃】和【异刃】）对1名目标对手造成2点法术伤害③。", [], []],
        "技能#神秘学者#言灵术": [8001, "言灵术", "言灵术", "法术", "普通", "None", "（将1-2张手牌面朝上放置在你角色旁【展示】作为【言灵】）你摸1张牌【强制】；（摸牌后，若你额外弃1张与现存【言灵】系别相同的牌【展示】）你+1【秘术】。", [], []],
        "技能#神秘学者#守护灵": [8002, "守护灵", "守护灵", "被动", "普通", "None", "（若【言灵】数>0，你被主动攻击命中时②，其他角色结算效果前）移除1个【言灵】；（若你【秘术】数>0）移除1点【秘术】，将1张手牌面朝上放置在你角色旁【展示】作为【言灵】。", [], []],
        "技能#神秘学者#真言术": [8003, "真言术", "真言术", "法术", "普通", "None", "（将1个除光系外的【言灵】视为手牌使用）执行相应的行动；（若使用的【言灵】为咏类命格或法术牌，或你额外移除1点【秘术】）本次相应行动执行完成后，对目标对手造成1点法术伤害③。", [], []],
        "技能#神秘学者#禁忌秘法": [8004, "禁忌秘法", "禁忌秘法", "响应", "普通", "None", "（你的回合开始前，移除3点【秘术】发动）指定2名目标角色各弃1张牌，你将弃牌面朝上放置在你角色旁【展示】作为【言灵】。", [], []],
        "技能#神秘学者#妖精秘术": [8005, "妖精秘术【回合限定】", "妖精秘术", "响应", "普通", "None", "（【真言术】或【真言压制】结算后发动）立即执行一次【攻击行动】；（若本次执行的攻击命中②）你+2【秘术】。", [], []],
        "技能#神秘学者#真言压制": [8006, "真言压制", "真言压制", "响应", "必杀技", "Crystal", "【水晶】（【真言术】结算后发动）对目标角色造成1点法术伤害③，你可立即执行一次【真言术】。", [], []],
        "技能#女仆长#影之穴": [8101, "影之穴", "影之穴", "启动", "普通", "None", "（移除1点【糸】）将【风穴】转移或放置于目标对手前，他弃1张牌。", [], []],
        "技能#女仆长#秘术·摹影": [8102, "秘术·摹影", "秘术·摹影", "响应", "普通", "None", "（主动攻击命中时发动②）将本次攻击牌面朝下放置在你角色旁作为【影】。", [], []],
