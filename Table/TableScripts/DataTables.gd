        "技能#圣使守护": [1504, "圣使守护", "圣使守护", "被动", "普通", "None", "你的【治疗】上限+4，你每次用【治疗】抵御伤害时，最多只能使用1点。", [], []],
        "技能#神圣契约": [1505, "神圣契约", "神圣契约", "启动", "必杀技", "Crystal", "【水晶】将你的X【治疗】转移给目标队友，以此法所转移的【治疗】无视他的【治疗】上限，但他的【治疗】最高为4。", [["发动【神圣契约】：点击目标头像分配【治疗】，选好后点「确定」"]], []],
        "技能#神圣领域": [1506, "神圣领域", "神圣领域", "法术", "必杀技", "Crystal", "【水晶】你弃2张牌，再选择以下一项发动：\\n　●（移除你的1【治疗】）对目标角色造成2点法术伤害③。\\n　●你+2【治疗】，目标队友+1【治疗】。", [["先选好要弃的牌，再点头像选目标，选好后点「确定」：选队友，含自己，你+2【治疗】、他+1【治疗】；选敌人，你-1【治疗】、他受2点法术伤害，【治疗】不足时点不了敌人"]], [["自己+2、目标队友+1【治疗】"], ["自己-1、目标受 2 点法术伤害"]]],
        "技能#光辉信仰": [1604, "光辉信仰", "光辉信仰", "法术", "普通", "None", "（仅【祈祷形态】下发动，移除1点【祈祷符文】）你弃2张牌，我方【战绩区】+1【宝石】，目标队友+1【治疗】。", [], []],
        "技能#黑暗诅咒": [1605, "黑暗诅咒", "黑暗诅咒", "法术", "普通", "None", "（仅【祈祷形态】下发动，移除1点【祈祷符文】）对目标角色和自己各造成2点法术伤害③。", [], []],
        "技能#威力赐福": [1602, "威力赐福", "威力赐福", "法术", "独有技", "None", "（将【威力赐福】放置于目标队友面前）该队友获得（攻击命中后可以移除此牌发动②）：本次攻击伤害额外+2。", [["发动【威力赐福】：本次攻击伤害+2"]], []],
        "技能#迅捷赐福": [1601, "迅捷赐福", "迅捷赐福", "法术", "独有技", "None", "（将【迅捷赐福】放置于目标队友面前）该队友获得（【法术行动】或【攻击行动】结束时可以移除此牌发动）额外+1【攻击行动】。", [], []],
        "技能#祈祷": [1603, "祈祷", "祈祷", "启动", "必杀技", "Gem", "【宝石】【横置】转为【祈祷形态】，在此形态下，你每发动一次主动攻击①，你+2【祈祷符文】。", [], []],
        "技能#法力潮汐": [1606, "法力潮汐", "法力潮汐", "响应", "必杀技", "Crystal", "【水晶】（【法术行动】结束时发动）额外+1【法术行动】。", [], []],
        "技能#智慧法典": [1701, "智慧法典", "智慧法典", "被动", "普通", "None", "你的【能量】上限+1；(承受法术伤害时⑥，若该伤害>3)你+2【宝石】并弃1张牌。", [["发动【智慧法典】：你+2【宝石】，请弃1张牌"]], []],
        "技能#法术反弹": [1704, "法术反弹", "法术反弹", "响应", "普通", "None", "(承受法术伤害时⑥，若该伤害仅为1点，你可以弃X张同系牌【展示】，X>1)对目标角色造成(X-1)点法术伤害③，并对自己造成X点法术伤害③。", [["发动【法术反弹】：弃2张以上同系牌并选目标"]], []],
        "技能#魔道法典": [1702, "魔道法典", "魔道法典", "法术", "必杀技", "Gem", "【宝石】(弃X张异系牌【展示】，X>1)对目标角色和自己各造成(X-1)点法术伤害③。", [], []],
        "技能#圣洁法典": [1703, "圣洁法典", "圣洁法典", "法术", "必杀技", "Gem", "【宝石】(弃X张异系牌【展示】，X>2)最多(X-2)名角色各+2【治疗】，并对自己造成(X-1)点法术伤害③。", [], []],
        "技能#灵符-雷鸣": [1802, "灵符-雷鸣", "灵符-雷鸣", "法术", "普通", "None", "（弃1张雷系牌【展示】）对任意2名角色各造成1点法术伤害③。", [], []],
        "技能#灵符-风行": [1801, "灵符-风行", "灵符-风行", "法术", "普通", "None", "（弃1张风系牌【展示】）指定2名角色各弃1张牌。", [], []],
        "技能#念咒": [1803, "念咒", "念咒", "响应", "普通", "None", "你每次发动【灵符】，可将自己1张【手牌】面朝下放置在你的角色旁，作为【妖力】。", [["发动【念咒】：把{n}张【手牌】作为【妖力】"]], []],
        "技能#百鬼夜行": [1804, "百鬼夜行", "百鬼夜行", "响应", "普通", "None", "（主动攻击命中后发动②，移除1个【妖力】）对目标角色造成1点法术伤害③；（若【妖力】为火系牌，可展示之【展示】）改为指定2名角色，对除他们以外的其他所有角色各造成1点法术伤害③。", [["发动【百鬼夜行】：移除{n}个【妖力】"]], [["展示火系【妖力】：指定2名角色"], ["不展示：指定1名角色"]]],
        "技能#灵力崩解": [1805, "灵力崩解", "灵力崩解", "响应", "必杀技", "Crystal", "【水晶】（和【灵符-雷鸣】或【百鬼夜行】同时发动）你的本次【灵符-雷鸣】或【百鬼夜行】每次造成的伤害额外+1。", [], []],
        "技能#剑魂守护": [1901, "剑魂守护", "剑魂守护", "被动", "普通", "None", "(主动攻击未命中时发动②)将本次打出的攻击牌面朝下放置在你的角色旁，作为【剑魂】。若你现有【能量】为单数，你的所有【剑魂】视为【天使之魂】；若为双数，视为【恶魔之魂】；若没有【能量】，则不属于任何一种。(若【剑魂】达到上限)你不能发动【剑魂守护】。", [], []],
        "技能#佯攻": [1902, "佯攻", "佯攻", "被动", "普通", "None", "(主动攻击未命中时发动②)你+1【剑气】。", [], []],
        "技能#剑气斩": [1903, "剑气斩", "剑气斩", "响应", "普通", "None", "(主动攻击命中后发动②，移除X点【剑气】，X最高为3)对除你所攻击的目标以外的任意一名角色造成X点法术伤害③。", [["发动【剑气斩】：选1名其他角色"]], [["移除{n}点【剑气】"]]],
        "技能#天使之魂": [1905, "天使之魂", "天使之魂", "响应", "普通", "None", "(主动攻击前发动①，移除1个【天使之魂】)本次攻击若命中②，你+2【治疗】；若未命中②，我方+1【士气】；不能和【剑魂守护】同时发动。", [["发动【天使之魂】：移除{n}张【剑魂】"]], []],
        "技能#恶魔之魂": [1906, "恶魔之魂", "恶魔之魂", "响应", "普通", "None", "(主动攻击前发动①，移除1个【恶魔之魂】)本次攻击伤害额外+1；若未命中②，你+2【剑气】；不能和【剑魂守护】同时发动。", [["发动【恶魔之魂】：移除{n}张【剑魂】"]], []],
        "技能#不屈意志": [1907, "不屈意志", "不屈意志", "响应", "必杀技", "Crystal", "【水晶】(【攻击行动】结束时发动)你摸1张牌【强制】，+1【剑气】，额外+1【攻击行动】。", [], []],
        "技能#天使与恶魔": [1904, "天使与恶魔", "天使与恶魔", "", "", "None", "", [], []],
        "技能#念气力场": [2001, "念气力场", "念气力场", "被动", "普通", "None", "所有对你造成的伤害每次最高为4点③。", [], []],
        "技能#蓄力一击": [2002, "蓄力一击", "蓄力一击", "响应", "普通", "None", "(主动攻击前发动①，+1【斗气】)本次攻击伤害额外+1；(若未命中②)对自己造成X点法术伤害③，X为你拥有的【斗气】数；(若【斗气】已经达到上限)你不能发动【蓄力一击】。", [[""], ["主动攻击：请选择要发动的技能，点「取消」＝都不发动"]], []],
        "技能#念弹": [2003, "念弹", "念弹", "响应", "普通", "None", "(【法术行动】结束时发动，+1【斗气】)对目标对手造成1点法术伤害③；(若发动前对方【治疗】为0)对自己造成X点法术伤害③，X为你拥有的【斗气】数；(若【斗气】已达到上限)你不能发动【念弹】。", [["发动【念弹】：选1名对手"]], []],
        "技能#百式幻龙拳": [2004, "百式幻龙拳", "百式幻龙拳", "启动", "普通", "None", "(移除3点【斗气】)【横置】你的所有主动攻击伤害额外+2，所有应战攻击伤害额外+1；在你接下来的行动阶段，你不能执行【法术行动】和【特殊行动】；你的主动攻击必须以同一名角色为目标，并且不能发动【蓄力一击】；若不如此做，则取消【百式幻龙拳】的效果并【重置】。", [], []],
        "技能#气绝崩击": [2005, "气绝崩击", "气绝崩击", "响应", "普通", "None", "(主动攻击前发动①，移除1点【斗气】)本次攻击对手无法应战，攻击后对自己造成X点法术伤害③，X为你的【斗气】数，不能发动【蓄力一击】。", [], []],
        "技能#斗神天驱": [2006, "斗神天驱", "斗神天驱", "启动", "必杀技", "Crystal", "【水晶】弃到3张牌，你+2【治疗】。", [], []],
        "技能#勇者之心": [2107, "勇者之心", "勇者之心", "被动", "普通", "None", "游戏初始时，你+2【水晶】。", [], []],
        "技能#怒吼": [2103, "怒吼", "怒吼", "响应", "普通", "None", "（主动攻击时发动①，移除1点【怒气】）你摸0-1张牌，本次攻击伤害额外+2；（若未命中②）你+1【知性】。", [["发动【怒吼】：要不要摸1张牌？"]], [["发动怒吼：摸 0 张牌"], ["发动怒吼：摸 1 张牌"]]],
        "技能#精疲力竭": [2106, "精疲力竭", "精疲力竭", "被动", "普通", "None", "（发动【禁断之力】后强制触发【强制】）【横置】额外+1【攻击行动】；持续到你的下个行动阶段开始，你的【手牌】上限恒定为4【恒定】。【精疲力竭】的效果结束时【重置】，并对自己造成3点法术伤害③。", [], []],
        "技能#明镜止水": [2104, "明镜止水", "明镜止水", "响应", "普通", "None", "（主动攻击前发动①，移除4点【知性】）本次攻击对手无法应战。（本次攻击结束时）你+1【水晶】。", [], []],
        "技能#挑衅": [2101, "挑衅", "挑衅", "法术", "专属技", "None", "挑衅：（移除1点【怒气】，将【挑衅】放置于目标对手面前）你+1【知性】；该对手在其下个行动阶段必须且只能主动攻击你，否则他跳过该行动阶段，触发后移除此牌。", [], []],
        "技能#禁断之力": [2102, "禁断之力", "禁断之力", "响应", "必杀技", "Crystal", "【水晶】（主动攻击命中或未命中时发动②）弃掉你所有【手牌】【展示】，其中每有1张法术牌，你+1【怒气】；（若未命中②）其中每有1张水系牌，你+1【知性】；（若命中②）其中每有1张火系牌，本次攻击伤害额外+1，并对自己造成等同于火系牌数量的法术伤害③。", [["发动【禁断之力】：弃掉全部{n}张【手牌】"]], []],
        "技能#死斗": [2105, "死斗", "死斗", "响应", "必杀技", "Gem", "【宝石】（承受法术伤害时发动⑥）你+3【怒气】；（若此伤害造成【士气】实际下降）本次下降的【士气】值恒定为1【恒定】。", [], []],
        "技能#灵魂吞噬": [2204, "灵魂吞噬", "灵魂吞噬", "被动", "普通", "None", "(我方每有1点【士气】下降)你+1【黄色灵魂】。", [], []],
        "技能#灵魂召还": [2205, "灵魂召还", "灵魂召还", "法术", "普通", "None", "(弃X张法术牌【展示】)你+X【蓝色灵魂】。", [], []],
        "技能#灵魂转换": [2206, "灵魂转换", "灵魂转换", "响应", "普通", "None", "(你每发动一次主动攻击①)可转换1点你拥有的【灵魂】的颜色。", [["发动【灵魂转换】：转换1点【灵魂】颜色"]], [["黄→蓝"], ["蓝→黄"]]],
        "技能#灵魂镜像": [2207, "灵魂镜像", "灵魂镜像", "法术", "普通", "None", "(移除2点【黄色灵魂】)你弃2张牌，目标角色摸2张牌【强制】(但最多补到其【手牌】上限)。", [["发动【灵魂镜像】：你弃2张牌，目标角色摸2张牌，选好后点「确定」"]], []],
        "技能#灵魂震爆": [2201, "灵魂震爆", "灵魂震爆", "法术", "独有技", "None", "(移除3点【黄色灵魂】)对目标角色造成3点法术伤害③，(若他【手牌】<3且【手牌】上限>5)则本次法术伤害额外+2。", [], []],
        "技能#灵魂赐予": [2202, "灵魂赐予", "灵魂赐予", "法术", "独有技", "None", "(移除3点【蓝色灵魂】)目标角色+2【宝石】。", [], []],
        "技能#灵魂链接": [2208, "灵魂链接", "灵魂链接", "启动", "专属技", "None", "（仅你队友数>1时可发动，移除1点【黄色灵魂】和1点【蓝色灵魂】）将此卡放置于目标队友面前。（若你拥有【灵魂链接】，每当你或灵魂术士将承受伤害前⑥，灵魂术士移除X点【蓝色灵魂】）将X点伤害转移给另一方，转移后的伤害为法术伤害⑥。", [["选择1名队友获得【灵魂链接】"], ["发动【灵魂链接】：选择转移的点数"]], [["替他承受{n}点"], ["替我承受{n}点"]]],
        "技能#灵魂增幅": [2203, "灵魂增幅", "灵魂增幅", "启动", "必杀技", "Gem", "【宝石】你+2【黄色灵魂】和2【蓝色灵魂】。", [], []],
        "技能#血之哀伤": [2303, "血之哀伤", "血之哀伤", "启动", "普通", "None", "（对自己造成2点法术伤害③）转移【同生共死】的目标或移除【同生共死】。", [["转移【同生共死】给选定目标"]], [["转移【同生共死】给选定目标"], ["移除【同生共死】"]]],
        "技能#流血": [2306, "流血", "流血", "被动", "普通", "None", "（当你在【普通形态】下因承受伤害而导致我方【士气】减少时强制发动【强制】）【横置】转为【流血形态】，你+1【治疗】，此形态下在你的每次回合开始时对自己造成1点法术伤害③。（自身【手牌】<3时强制触发【强制】）【重置】脱离【流血形态】。", [], []],
        "技能#逆流": [2304, "逆流", "逆流", "法术", "普通", "None", "（仅【流血形态】下可发动）你弃2张牌，你+1【治疗】。", [], []],
        "技能#血之悲鸣": [2301, "血之悲鸣", "血之悲鸣", "法术", "独有技", "None", "（仅【流血形态】下可发动）对目标角色和自己各造成(X+1)点法术伤害③，X<3。", [["对目标与自身各造成1点法术伤害"]], [["对目标与自身各造成1点法术伤害"], ["对目标与自身各造成2点法术伤害"], ["对目标与自身各造成3点法术伤害"]]],
        "技能#同生共死": [2302, "同生共死", "同生共死", "法术", "专属技", "None", "（摸2张牌【强制】，将【同生共死】放置于目标角色面前）\\n在【普通形态】下，你和他【手牌】上限各-2。\\n在【流血形态】下，你和他【手牌】上限各+1。", [], []],
        "技能#血之诅咒": [2351, "血之诅咒", "血之诅咒", "法术", "必杀技", "Gem", "【宝石】对目标角色造成2点法术伤害③，你弃3张牌。", [], []],
        "技能#生命之火": [2401, "生命之火", "生命之火", "被动", "普通", "None", "你的【手牌】上限-X，X为你拥有的【蛹】的数量，但你的【手牌】上限最少为3【恒定】。", [], []],
        "技能#舞动": [2402, "舞动", "舞动", "法术", "普通", "None", "（摸1张牌【强制】或弃1张牌【强制】）将牌库顶的1张牌面朝下放置在你角色旁，作为【茧】。", [["摸1张牌"]], [["摸1张牌"], ["弃1张牌"]]],
        "技能#毒粉": [2403, "毒粉", "毒粉", "响应", "普通", "None", "（每当有角色产生1点实际法术伤害时发动⑤，移除1个【茧】）该次伤害额外+1。", [["发动【毒粉】：移除{n}个【茧】，该次伤害额外+1"]], []],
        "技能#朝圣": [2404, "朝圣", "朝圣", "响应", "普通", "None", "(每当你承受伤害时发动⑥，移除1个【茧】)抵御1点该来源的伤害。", [["发动【朝圣】：本次受到{dmg}伤害，移除{n}个【茧】，抵御1点该来源伤害"]], []],
        "技能#镜花水月": [2405, "镜花水月", "镜花水月", "响应", "普通", "None", "（每当有角色产生2点实际法术伤害时发动⑤，移除2个同系【茧】【展示】）抵御该次伤害，你对他造成2次法术伤害③，每次伤害为1点。", [["发动【镜花水月】：移除{n}个同系【茧】，抵御该次伤害并造成2次1点法术伤害"]], []],
        "技能#凋零": [2406, "凋零", "凋零", "响应", "普通", "None", "（你每次移除【茧】时，若为法术牌，可展示之【展示】）你对目标角色造成1点法术伤害③，再对自己造成2点法术伤害③；此技能发动后，直到你的下个回合开始前，对方的【士气】最少为1【强制】。", [["发动【凋零】：选1名目标"]], []],
        "技能#蛹化": [2407, "蛹化", "蛹化", "法术", "必杀技", "Gem", "【宝石】（你+1【蛹】）将牌库顶的4张牌面朝下放置在你角色旁，作为【茧】。", [], []],
        "技能#倒逆之蝶": [2408, "倒逆之蝶", "倒逆之蝶", "法术", "必杀技", "Crystal", "【水晶】你弃2张牌，再选择以下一项发动：\\n　●对目标角色造成1点法术伤害③，该伤害不能用【治疗】抵御。\\n　●（移除2个【茧】或对自己造成4点法术伤害③）移除1点【蛹】。", [["对目标角色造成1点法术伤害，不能用【治疗】抵挡"]], [["对目标角色造成1点法术伤害，不能用【治疗】抵挡"], ["移除2个【茧】，移除1个【蛹】"], ["对自己造成4点法术伤害，移除1个【蛹】"]]],
        "技能#神圣追击": [2501, "神圣追击", "神圣追击", "响应", "普通", "None", "（【攻击行动】或【法术行动】结束后，移除你的1【治疗】）额外+1【攻击行动】。", [], []],
        "技能#秩序之印": [2502, "秩序之印", "秩序之印", "法术", "普通", "None", "（摸2张牌【强制】）你+1【治疗】并+1【水晶】。", [], []],
        "技能#和平行者": [2503, "和平行者", "和平行者", "被动", "普通", "None", "（你的回合内，发动【英灵召唤】后强制触发【强制】）【横置】转为【英灵形态】；（当你执行主动攻击行动时①）【重置】脱离【英灵形态】。", [], []],
        "技能#军神威光": [2504, "军神威光", "军神威光", "被动", "普通", "None", "（回合开始时，若你处于【英灵形态】）选择以下一项发动：\\n　●你+1【治疗】，【重置】脱离【英灵形态】。\\n　●（移除我方【战绩区】X个【星石】，X<3）目标角色+X【治疗】。", [["发动【军神威光】：二选一，选好后点「确定」{取消说明}"], [""], ["移除我方【战绩区】X个【星石】，X 小于 3，由你选择一个目标角色+X【治疗】"], ["战绩区 -2【水晶】"], ["战绩区 -1【水晶】-1【宝石】"], ["战绩区 -2【宝石】"], ["战绩区 -1【水晶】"], ["战绩区 -1【宝石】"]], [["你+1【治疗】，并脱离【英灵形态】"], ["移除我方【战绩区】X个【星石】（X<3），由你选择一个目标角色+X【治疗】"]]],
        "技能#英灵召唤": [2505, "英灵召唤", "英灵召唤", "响应", "必杀技", "Crystal", "【水晶】（攻击命中时发动②）本次攻击伤害额外+1，（若你额外弃1张法术牌【展示】）目标角色+1【治疗】。", [["发动【英灵召唤】：额外弃1张法术牌，目标角色+1【治疗】"], ["【英灵召唤】：额外弃 1 张法术牌【展示】，指定 1 名角色+1【治疗】"]], []],
        "技能#魔贯冲击": [2601, "魔贯冲击", "魔贯冲击", "响应", "普通", "None", "(主动攻击前发动①，移除1个火系【充能】)本次攻击伤害额外+1，不能攻击【手牌】达到上限的对手；(若命中②，额外移除1个火系【充能】)本次攻击伤害额外+1；(若未命中②)对对手造成3点法术伤害③；本回合你不能发动【多重射击】。", [["发动【魔贯冲击】：移除{n}个火系【充能】"], ["发动【魔贯冲击】：再移除{n}个火系【充能】"]], []],
        "技能#雷光散射": [2602, "雷光散射", "雷光散射", "法术", "普通", "None", "(移除1个雷系【充能】)对所有对手各造成1点法术伤害③；(若你额外移除X个雷系【充能】)指定一名对手，本次对其造成的伤害额外+X③。", [["发动【雷光散射】：选择更多雷系【充能】可对选定目标额外造成伤害，选好后点「确定」"]], [["移除 %d 张"]]],
        "技能#多重射击": [2603, "多重射击", "多重射击", "响应", "普通", "None", "(【攻击行动】结束时发动，移除1个风系【充能】)视为一次暗系的主动攻击，但不能攻击上次的目标且本次攻击伤害-1；本回合你不能发动【魔贯冲击】。", [["发动【多重射击】：移除{n}个风系【充能】，视为-1伤害的暗系主动攻击"], ["攻击结束时可以发动多重射击"]], []],
        "技能#充能": [2604, "充能", "充能", "启动", "必杀技", "Crystal", "【水晶】你弃到4张牌，摸X张牌【强制】，可将自己最多X张【手牌】面朝下放置在你的角色旁，作为【充能】(X<5)；本回合你不能发动【魔贯冲击】和【雷光散射】。", [["发动【充能】：把至多{n}张【手牌】作为【充能】"]], [["摸{n}张"]]],
        "技能#魔眼": [2605, "魔眼", "魔眼", "启动", "必杀技", "Gem", "【宝石】目标角色弃1张牌或你摸3张牌【强制】，将自己1张【手牌】面朝下放置在你的角色旁，作为【充能】，你+1【水晶】。", [["发动【魔眼】：把{n}张【手牌】作为【充能】"]], [["自己摸3张牌"], ["指定一名角色弃1张牌"]]],
        "技能#战纹掌控": [2707, "战纹掌控", "战纹掌控", "被动", "普通", "None", "游戏初始时，你拥有3个【战纹】。", [], []],
        "技能#怒火压制": [2704, "怒火压制", "怒火压制", "响应", "普通", "None", "（主动攻击未命中时②）翻转1个【战纹】，不能和【魔纹融合】同时发动。", [["怒火压制：翻转1个【战纹】为【魔纹】"]], []],
        "技能#战纹碎击": [2703, "战纹碎击", "战纹碎击", "响应", "普通", "None", "（主动攻击命中时②，翻转1个【战纹】，弃X张同系牌【展示】（X>1））本次攻击伤害额外+（X-1），（若你处于【蓄势迸发形态】下，额外翻转Y个【战纹】）本次攻击伤害额外+Y。", [["发动【战纹碎击】：弃{n}张同系牌"], ["翻转1个【战纹】"], ["翻转1个【战纹】，并额外翻转{n}个，伤害+{n}"]], []],
        "技能#魔纹融合": [2701, "魔纹融合", "魔纹融合", "响应", "普通", "None", "（主动攻击未命中时②，翻转1个【魔纹】，弃X张异系牌【展示】（X>1））对本次攻击的角色造成（X-1）点法术伤害③，（若你处于【蓄势迸发形态】下，额外翻转Y个【魔纹】）本次法术伤害额外+Y。", [], [["魔纹融合"], ["魔纹融合翻转 1 个【魔纹】"], ["额外翻转 1 个【魔纹】"], ["额外翻转 2 个【魔纹】"]]],
        "技能#符文改造": [2705, "符文改造", "符文改造", "启动", "必杀技", "Gem", "【宝石】【横置】持续到你的回合结束时，你都处于【蓄势迸发形态】，此形态下你的【手牌】上限+1；摸1张牌【强制】并任意调整你的【战纹】和【魔纹】；脱离【蓄势迸发形态】时【重置】。", [["【战纹】{n}/【魔纹】{n2}"]], [["【战纹】{n}/【魔纹】{n2}"]]],
        "技能#双重回响": [2706, "双重回响【回合限定】", "双重回响", "响应", "必杀技", "Crystal", "【水晶】（对目标角色造成攻击或法术伤害时发动③）对另一目标角色造成X点法术伤害③，X与本次伤害相同但最高为3。【双重回响】的伤害不会造成【士气】下降。", [["发动【双重回响】：选另一名目标造成伤害"]], []],
        "技能#猩红圣约": [2801, "猩红圣约【回合限定】", "猩红圣约", "响应", "普通", "None", "（主动攻击时发动①）你+1【治疗】。", [], []],
        "技能#猩红信仰": [2802, "猩红信仰", "猩红信仰", "被动", "普通", "None", "你的【治疗】只能抵御自己造成的伤害，你的【治疗】上限+2。", [], []],
        "技能#血腥祷言": [2803, "血腥祷言", "血腥祷言", "启动", "普通", "None", "（移除你的X【治疗】，对自己造成X点法术伤害③）任意分配X【治疗】给1~2名队友，你+1【血印】。", [["发动【血腥祷言】：点击头像分配任意点数【治疗】，选好后点「确定」"]], []],
        "技能#杀戮盛宴": [2806, "杀戮盛宴", "杀戮盛宴", "响应", "普通", "None", "（主动攻击命中后发动②，移除1点【血印】）对自己造成4点法术伤害③，本次攻击伤害额外+2。", [], []],
        "技能#热血沸腾": [2807, "热血沸腾", "热血沸腾", "被动", "普通", "None", "（当你因承受伤害而导致我方【士气】下降时强制发动【强制】）【横置】转为【热血沸腾形态】，此形态下你承受伤害不会导致我方【士气】下降【强制】。在你的回合结束阶段，若你处于此形态，【重置】并脱离此形态【强制】，你+2【治疗】。", [], []],
        "技能#戒骄戒躁": [2808, "戒骄戒躁", "戒骄戒躁", "响应", "必杀技", "Crystal", "【水晶】（仅【热血沸腾形态】下，【攻击行动】或【法术行动】结束时发动）【重置】并脱离此形态，额外+1【攻击行动】或【法术行动】。", [], []],
        "技能#猩红十字": [2809, "猩红十字", "猩红十字", "法术", "必杀技", "None", "【水晶】（移除1点【血印】，弃2张法术牌【展示】，对自己造成4点法术伤害③）对目标角色造成3点法术伤害③。", [], []],
        "技能#暗之解放": [2901, "暗之解放", "暗之解放", "启动", "普通", "None", "【横置】转为【幻影形态】，你的【手牌】上限恒定为5【恒定】；本回合你的下次主动攻击伤害额外+1，但不能发动【漆黑之枪】和【充盈】。", [], []],
        "技能#幻影星辰": [2902, "幻影星辰", "幻影星辰", "启动", "普通", "None", "（仅【幻影形态】下发动，对自己造成2点法术伤害③）【重置】脱离【幻影形态】；若没有因此造成我方【士气】下降，则对目标角色造成2点法术伤害③。", [], []],
        "技能#黑暗束缚": [2903, "黑暗束缚", "黑暗束缚", "被动", "普通", "None", "你始终不能使用法术牌。", [], []],
        "技能#暗之障壁": [2904, "暗之障壁", "暗之障壁", "响应", "普通", "None", "（任何人对你造成伤害时发动③）弃X张法术牌或雷系牌【展示】。", [["发动【暗之障壁】：受到{伤害}伤害，弃任意数量的法术牌或雷系牌"]], []],
        "技能#充盈": [2905, "充盈", "充盈", "法术", "普通", "None", "（弃1张法术牌或雷系牌【展示】）所有人各弃一张牌【展示】，我方角色可选择不如此做，除你以外每以此法弃1张法术牌或雷系牌，本回合你的下次主动攻击伤害额外+1；额外+1【攻击行动】。", [["请选择{n}张【手牌】弃掉"]], []],
        "技能#漆黑之枪": [2906, "漆黑之枪", "漆黑之枪", "响应", "必杀技", "Crystal", "X【水晶】（仅【幻影形态】下，主动攻击【手牌】为1或2的对手并命中后发动②）本次攻击伤害额外+(X+2)。", [["投入{n}点【能量】，伤害+{n2}"], ["发动【漆黑之枪】：选择投入的【能量】"]], [["投入{n}点【能量】（伤害+{n2}）"]]],
        "技能#苍炎法典": [3001, "苍炎法典", "苍炎法典", "法术", "普通", "None", "（弃1张火系牌【展示】）对目标角色和自己各造成2点法术伤害③。", [], []],
        "技能#天火断空": [3002, "天火断空", "天火断空", "法术", "普通", "None", "（弃2张火系牌【展示】，移除1点【重生】）对目标角色和自己各造成3点法术伤害③，（若我方【士气】落后于该目标）本次法术伤害额外+1【强制】。", [], []],
        "技能#魔女之怒": [3003, "魔女之怒", "魔女之怒", "启动", "普通", "None", "（【手牌】<4张时）【横置】摸0-2张牌，数值由你决定，持续到你的下个行动阶段开始前，你都处于【烈焰形态】，在此形态下你的所有除水系和暗系外的攻击牌均视为火系【强制】，你发动【天火断空】时无需移除【重生】，你的【手牌】上限+(X-2)（X为你的【重生】数量）；脱离【烈焰形态】时【重置】。", [["摸0张牌"]], [["摸0张牌"], ["摸1张牌"], ["摸2张牌"]]],
        "技能#替身玩偶": [3004, "替身玩偶", "替身玩偶", "响应", "普通", "None", "（任何人对你造成攻击伤害时③，弃1张法术牌【展示】）目标队友摸1张牌【强制】。", [["发动【替身玩偶】：弃{n}张法术牌"]], []],
        "技能#永生银时计": [3005, "永生银时计", "永生银时计", "被动", "普通", "None", "（当你因承受法术伤害而造成【士气】下降时）你+1【重生】。", [], []],
        "技能#痛苦链接": [3006, "痛苦链接", "痛苦链接", "法术", "必杀技", "Crystal", "【水晶】对目标对手和自己各造成1点法术伤害③，然后你弃到3张牌。", [], []],
        "技能#魔能反转": [3007, "魔能反转", "魔能反转", "响应", "必杀技", "Crystal", "【水晶】（任何人对你造成法术伤害时③，弃X张法术牌【展示】，X>1）对目标对手造成(X-1)点法术伤害③。", [["发动【魔能反转】：弃大于2张法术牌，造成弃置数量-1法术伤害"]], []],
        "技能#沉沦协奏曲": [3101, "沉沦协奏曲", "沉沦协奏曲", "响应", "普通", "None", "(仅【普通形态】下一回合内我方对至少2名对手造成法术伤害③且结算完后，弃2张同系牌【展示】)你+1【灵感】；(若弃牌中有法术牌)对目标对手造成1点法术伤害③。", [["发动【沉沦协奏曲】：弃{n}张同系牌并选目标"]], []],
        "技能#不谐和弦": [3102, "不谐和弦", "不谐和弦", "法术", "普通", "None", "(移除X点【灵感】，X>1)你选择以下一项发动：\\n　●你和目标角色各摸(X-1)张牌【强制】；(若你处于【永恒囚徒形态】)【重置】脱离【永恒囚徒形态】。\\n　●你和目标角色各弃(X-1)张牌；(若你处于【永恒囚徒形态】)【重置】脱离【永恒囚徒形态】。", [["请选择{n}张【手牌】弃掉"], ["移除{n}点【灵感】，双方各摸{n2}张牌"]], [["移除 %d 点灵感"], ["你和目标角色各摸 %d 张牌"], ["你和目标角色各弃 %d 张牌"]]],
        "技能#禁忌诗篇": [3103, "禁忌诗篇", "禁忌诗篇", "被动", "普通", "None", "(【激昂狂想曲】或【胜利交响诗】的效果结算完后)根据【灵感】数量：\\n　●(【灵感】未达到上限)你+1【灵感】，移除【永恒乐章】。\\n　●(【灵感】已达到上限)对自己造成3点法术伤害③；(若你处于【普通形态】)【横置】转为【永恒囚徒形态】【持续】。", [], []],
        "技能#激昂狂想曲": [3105, "激昂狂想曲", "激昂狂想曲", "响应", "专属技", "None", "（回合开始时若你拥有【永恒乐章】）选择以下一项执行：\\n　●吟游诗人对2名目标对手各造成1点法术伤害③。\\n　●你弃2张牌。", [["对两名目标各1点法术伤害"]], [["对两名目标各1点法术伤害"], ["弃2张牌"]]],
        "技能#胜利交响诗": [3106, "胜利交响诗", "胜利交响诗", "响应", "专属技", "None", "（回合结束时若你拥有【永恒乐章】）选择以下一项执行：\\n　●将我方【战绩区】的1【星石】提炼成为你的【能量】。\\n　●为我方【战绩区】+1【宝石】，你+1【治疗】。", [["发动【胜利交响诗】：选择要执行的一项"], ["将己方【战绩区】的1【星石】提炼为你的【能量】"]], [["将己方【战绩区】的1【星石】提炼为你的【能量】"], ["己方【战绩区】+1【宝石】，你+1【治疗】"], ["提炼1个【水晶】"], ["提炼1个【宝石】"]]],
        "技能#希望赋格曲": [3107, "希望赋格曲", "希望赋格曲", "启动", "必杀技", "Gem", "【水晶】你可以选择摸1张牌，然后选择以下一项发动：\\n　●将【永恒乐章】放置于目标队友面前。\\n　●将【永恒乐章】转移给我方另一目标角色，你弃1张牌，+1【治疗】或+1【灵感】。", [["发动【希望赋格曲】：把【永恒乐章】转移给队友"]], [["将【永恒乐章】放置于目标队友面前"], ["将【永恒乐章】转移给我方另一目标角色，你弃 1 张牌，+1【治疗】或 +1【灵感】"], ["摸 1 张牌"], ["不摸牌"], ["+1【治疗】"], ["+1 灵感"]]],
        "技能#元素射击": [3201, "元素射击【回合限定】", "元素射击", "响应", "普通", "None", "(主动攻击时①，若攻击牌非暗系，弃1张法术牌或移除1个【祝福】)根据攻击牌系别附加以下【元素箭】效果：\\n【元素箭】\\n【火之矢】：本次攻击伤害额外+1。\\n【水之矢】：(主动攻击命中时②)目标角色+1【治疗】。\\n【风之矢】：(【攻击行动】结束后)额外+1【攻击行动】。\\n【雷之矢】：本次攻击无法应战。\\n【地之矢】：(主动攻击命中时②)对目标角色造成1点法术伤害③。", [["发动【元素射击】：弃1张法术牌或移除1张【祝福】"], ["【水之矢】：目标角色+1【治疗】"], ["【地之矢】：对目标角色造成 1 点法术伤害"]], []],
        "技能#动物伙伴": [3202, "动物伙伴", "动物伙伴", "响应", "普通", "None", "(你的回合内，目标角色承受你造成的伤害⑥后)你摸1张牌【强制】，弃1张牌。", [["弃{n}张【手牌】【强制】"], ["你摸1张、弃1张【强制】"]], [["你摸 1 张、弃 1 张【强制】"]]],
        "技能#精灵密仪": [3203, "精灵密仪【持续】", "精灵密仪", "启动", "必杀技", "Gem", "【宝石】【横置】转为【精灵祝福形态】，将牌库顶的3张牌面朝下放置于角色旁作为【祝福】。此形态下你的【祝福】可视为【手牌】使用或打出。(你的回合结束时，若你未拥有【祝福】)【重置】脱离【精灵祝福形态】，对目标角色造成2点法术伤害③。", [["选择1名角色承受2点法术伤害"]], []],
        "技能#宠物强化": [3204, "宠物强化", "宠物强化", "响应", "必杀技", "Crystal", "【水晶】(触发【动物伙伴】时)效果改为“目标角色摸1张牌【强制】弃1张牌”。", [["消耗 1 能量，改为令 1 名角色摸 1 张、弃 1 张【强制】"]], [["消耗 1 能量，改为令 1 名角色摸 1 张、弃 1 张【强制】"]]],
        "技能#武者残心": [3601, "武者残心【回合限定】", "武者残心", "响应", "普通", "None", "(【攻击行动】结束时)你+1【残心】。", [], []],
        "技能#一击无念": [3602, "一击无念", "一击无念", "响应", "普通", "None", "(【攻击行动】结束后，移除4点【残心】)额外+1【攻击行动】，本次攻击无视【圣盾】且无法使用【圣光】抵挡；(若攻击牌为技类命格)本次攻击强制命中。", [], []],
        "技能#兽魂意念": [3603, "兽魂意念", "兽魂意念", "被动", "普通", "None", "(你每移除1点【兽魂】)你+1【残心】；(当你处于【普通形态】，主动攻击命中时②)你+1【兽魂】。", [], []],
        "技能#兽魂警戒": [3604, "兽魂警戒【持续】", "兽魂警戒", "响应", "普通", "None", "(其他角色【横置】结算完成后，移除1点【兽魂】，【横置】转为【御魂流居合形态】)目标角色弃1张牌【展示】；(若弃牌为法术牌)你+1【兽魂】。", [], []],
        "技能#兽返": [3605, "兽返", "兽返", "响应", "普通", "None", "(目标角色对你造成法术伤害时③，移除X点【兽魂】)你弃X张牌，他弃1张牌【展示】；(若他的弃牌为法术牌)你+1【兽魂】。", [], [["移除 %d 点兽魂，弃 %d 张手牌"]]],
        "技能#御魂流居合形态": [3608, "御魂流居合形态", "御魂流居合形态", "被动", "普通", "None", "在此形态下，你对【横置】目标攻击伤害+1。你的回合结束前，移除1点【兽魂】。(你造成伤害时⑥，或你回合结束时【兽魂】数为0)【重置】脱离【御魂流居合形态】。", [], []],
        "技能#逆反居合斩": [3606, "逆反居合斩", "逆反居合斩", "响应", "普通", "None", "(仅【御魂流居合形态】下，攻击手牌<4的对手前发动①)移除X点【兽魂】。本次攻击命中时②，改为攻击目标弃置(X+2)张手牌；(若因此弃牌数<X+2)对方士气-1。", [["弃掉 {n} 张牌，若弃少于 {n} 则士气 -1"]], [["不移除兽魂，目标弃 2 张"], ["移除 %d 点兽魂，目标弃 %d 张"]]],
        "技能#御魂流居合式": [3607, "御魂流居合式【持续】", "御魂流居合式", "启动", "必杀技", "None", "无视你的【兽魂】上限为你+1【兽魂】，你可以选择摸或弃1张牌；(若你处于【御魂流居合形态】)你+1【残心】；(若你处于【普通形态】)【横置】转为【御魂流居合形态】。", [], [["弃 1 张手牌"], ["摸 1 张牌"], ["不调整"]]],
        "技能#式神降临": [3303, "式神降临【持续】", "式神降临", "法术", "普通", "None", "(弃2张命格相同的手牌【展示】)【横置】转为【式神形态】，你+1【鬼火】，额+1【攻击行动】。", [], []],
        "技能#阴阳转换": [3306, "阴阳转换", "阴阳转换", "响应", "普通", "None", "(应战攻击时①，打出1张与攻击牌命格相同的攻击牌【展示】)视为你应战此次攻击，并将本次攻击系别转为与此牌相同。你+1【鬼火】。(若处于【式神形态】，【重置】脱离【式神形态】)本次攻击伤害为X，X为你的【鬼火】数。", [["发动【阴阳转换】：选择效果后打出应战牌"]], [["仅应战"], ["发动阴阳转换并应战，+1 鬼火"], ["发动阴阳转换，再发动式神转换并应战，摸 1 张，+2 鬼火"]]],
        "技能#式神转换": [3305, "式神转换", "式神转换", "响应", "普通", "None", "(与【阴阳转换】同时发动)你摸1张牌【强制】，+1【鬼火】。", [], []],
        "技能#黑暗祭礼": [3302, "黑暗祭礼", "黑暗祭礼", "被动", "普通", "None", "(你的回合结束时，若【鬼火】达到上限)移除所有【鬼火】，对目标角色造成2点法术伤害③。", [["发动【黑暗祭礼】：选目标造成2点法术伤害"]], []],
        "技能#式神咒束": [3301, "式神咒束", "式神咒束", "响应", "普通", "None", "(目标队友受到主动攻击时①，若此攻击可应战且你处于【式神形态】，打出1张合理的应战攻击牌【展示】，移除我方【战绩区】1【宝石】1【水晶】)将本次攻击目标变更为你，且视为你使用此牌执行应战攻击。", [], [["仅应战"], ["发动阴阳转换并应战，+1 鬼火"], ["发动阴阳转换，再发动式神转换并应战，摸 1 张，+2 鬼火"]]],
        "技能#生命结界": [3304, "生命结界", "生命结界", "法术", "必杀技", "Crystal", "【水晶】你+1【鬼火】，选择以下一项发动：\\n　●目标队友+1【宝石】并+1【治疗】；然后你对自己造成X点法术伤害③，X为你的【鬼火】数。(若X为3)本次法术伤害不会造成我方士气下降。\\n　●(仅【式神形态】下，弃2张命格相同的手牌【展示】)【重置】脱离【式神形态】，目标队友弃1张牌。", [["目标队友+1【宝石】+1【治疗】；然后你受到X点法术伤害"], [""], ["弃掉 {n} 张牌"]], [["目标队友+1【宝石】+1【治疗】；然后你受到X点法术伤害"], ["弃2张命格相同的手牌【展示】，重置退出【式神形态】；目标队友弃1张牌"]]],
        "技能#血色荆棘": [3401, "血色荆棘", "血色荆棘", "被动", "普通", "None", "（攻击命中时②）你+1【鲜血】。", [], []],
        "技能#赤色一闪": [3402, "赤色一闪", "赤色一闪", "响应", "普通", "None", "（【攻击行动】结束后，移除1点【鲜血】，对自己造成2点法术伤害③）额外+1【攻击行动】。", [], []],
        "技能#血染蔷薇": [3403, "血染蔷薇", "血染蔷薇", "法术", "普通", "None", "（移除2点【鲜血】）移除目标角色2【治疗】，将我方角色【能量区】的1【水晶】翻面为1【宝石】。（若【血蔷薇庭院】在场）额外对所有角色各造成1点法术伤害③。", [["发动【血染蔷薇】：选择一名友方角色；若其有【水晶】，将 1【水晶】翻面为 1【宝石】"]], []],
        "技能#血气屏障": [3404, "血气屏障", "血气屏障", "响应", "普通", "None", "（目标角色对你造成法术伤害③时，移除1点【鲜血】）本次法术伤害-1③，对目标对手造成1点法术伤害③。", [["发动【血气屏障】：-1【鲜血】，本次法术伤害 -1，对目标对手造成 1 点法术伤害"]], []],
