        "技能#结界师#绝界": [8206, "绝界", "绝界", "被动", "专属技", "None", "【被动】灭界破散； （结界师的【结界】为0时）结界师【横置】，移除【绝界】。 （拥有此卡的角色回合结束前）结界师移除1个【结界】。 【响应】白二羯磨； （若你拥有【绝界】，你的【攻击行动】结束时发动）结界师+1【祭】，你将1个【结界】加入手牌【强制】。 【被动】虚空境； （若你拥有【绝界】）你拥有的基础效果无法触发。", [], []],
        "技能#结界师#伏魔境": [8207, "伏魔境", "伏魔境", "响应", "必杀技", "Crystal", "【水晶】（每当你【祭】增加时发动）对目标对手造成1点法术伤害③；（若因此造成对方士气下降，移除我方【战绩区】1星石）你+1【水晶】。", [[""], [""], ["【伏魔境】：指定 1 名目标对手"]], []],
        "技能#染污者#神弃之裔": [8301, "神弃之裔", "神弃之裔", "被动", "普通", "None", "游戏初始时，你+1【水晶】。你的【治疗】上限为0【恒定】，你始终无法获得或使用【治疗】，你对拥有【治疗】的角色伤害额外+1。", [], []],
        "技能#染污者#戾如泉涌": [8302, "戾如泉涌【回合限定】", "戾如泉涌", "响应", "普通", "None", "（仅【普通形态】下且你【戾气】数<2，【攻击行动】或【法术行动】结束后发动）你+1【戾气】，额外+1【攻击行动】。", [], []],
        "技能#染污者#狂戾之心": [8303, "狂戾之心【持续】", "狂戾之心", "被动", "普通", "None", "（你的回合开始时或承受伤害后⑥，且【戾气】达到上限时）你弃1张牌，指定目标角色移除2【治疗】，【横置】转为【狂戾形态】，此形态下你无法使用【圣光】，你造成的伤害额外+1。 （你的回合结束时若【戾气】数为0）【转正】脱离【狂戾形态】，将你的1【水晶】转换为1【宝石】。", [], []],
        "技能#染污者#狂戾之体": [8304, "狂戾之体", "狂戾之体", "被动", "普通", "None", "（仅【狂戾形态】下且你【戾气】数>0，目标角色对你造成伤害时③）移除1点【戾气】，本次伤害额外+1，但伤害最高为4。", [], []],
        "技能#染污者#神智污染": [8305, "神智污染", "神智污染", "响应", "普通", "None", "（仅【狂戾形态】下，你对目标角色造成伤害时发动③，移除1点【戾气】）本次伤害额外+1，本次你造成的伤害无法以【治疗】抵御。", [], []],
        "技能#染污者#扭曲之爱": [8306, "扭曲之爱", "扭曲之爱", "启动", "必杀技", "Gem", "【宝石】调整你的形态为【普通形态】或【狂戾形态】，你弃2张牌或摸2张牌【强制】，并任意调整你的【戾气】数。", [], []],
        "技能#咒符师#咒符-火璃": [8401, "咒符-火璃", "咒符-火璃", "法术", "普通", "None", "（弃1张火系牌①）对1名目标角色造成1点法术伤害③，你摸1张牌，弃1张牌。", [], []],
        "技能#咒符师#咒符-冻天": [8402, "咒符-冻天", "咒符-冻天", "法术", "普通", "None", "（弃1张水系牌①）指定1名目标角色弃1张牌，将除你外1名目标角色的1【治疗】转移给你。", [], []],
        "技能#咒符师#念咒": [8403, "念咒", "念咒", "响应", "普通", "None", "每当你发动【咒符】，可将自己的1张手牌面朝下放置在你的角色旁，作为【妖力】。", [], []],
        "技能#咒符师#魑魅魍魉": [8404, "魑魅魍魉", "魑魅魍魉", "响应", "普通", "None", "（主动攻击命中后发动②，移除1个【妖力】）视为无条件发动一次【咒符-火璃】或【咒符-冻天】，但无法发动念咒；（若【妖力】为地系牌，可展示之【展示】）该次【火璃】的伤害或【冻天】的弃牌效果+1。", [], [["发动【咒符-火璃】"], ["发动【咒符-冻天】"]]],
        "技能#咒符师#咒力重塑": [8405, "咒力重塑", "咒力重塑", "响应", "必杀技", "Crystal", "【水晶】（发动【咒符-火璃】或【咒符-冻天】时发动）将“1名目标角色”改为“2名目标角色”。", [], []],
        "技能#捣蛋萝莉#天使？": [8601, "天使？", "天使？", "响应", "普通", "None", "你可将有【天使之墙】的基础牌作为【圣盾】使用。", [], []],
        "技能#捣蛋萝莉#叛逆之墙": [8602, "叛逆之墙", "叛逆之墙", "法术", "普通", "None", "（将手牌的1个【圣盾】【展示】与场上的1个基础效果交换）你弃1张牌。", [], []],
        "技能#捣蛋萝莉#神秘伏笔": [8603, "神秘伏笔", "神秘伏笔", "被动", "普通", "None", "（【法术行动】结束后）将牌库顶1-2张牌面朝下放置于X名目标角色面前，视为基础效果【Tricky】。", [], []],
        "技能#捣蛋萝莉#T-r-i-c-k-y!": [8604, "T-r-i-c-k-y!", "T-r-i-c-k-y!", "响应", "普通", "None", "（主动攻击未命中时发动②）查看1个【Tricky】。（若你移除该【Tricky】并额外弃1张同系牌）对原拥有该【Tricky】的目标角色造成2点法术伤害③。", [], []],
        "技能#捣蛋萝莉#Trick or Treat": [8605, "Trick or Treat", "Trick or Treat", "被动", "普通", "None", "（你的行动阶段结束时，若场上存在的【Tricky】>4，展示所有【Tricky】）所有人各弃1张与面前【Tricky】同系的牌，然后移除所有【Tricky】。（每有人不如此做）你对他造成2点法术伤害③。（若我方对应【Tricky】弃牌>对方）我方【战绩区】+1【水晶】且你+1【水晶】，或你弃1张牌并额外获得一个回合；（若我方对应【Tricky】弃牌<对方）对方【战绩区】+1【宝石】。", [], []],
        "技能#捣蛋萝莉#Surprise!": [8606, "Surprise!", "Surprise!", "法术", "必杀技", "Crystal", "【水晶】（你弃1张牌）本回合结束前你的手牌上限+5， 将场上所有【Tricky】加入手牌，然后将X张手牌面朝下放置于X名目标角色面前，视为基础效果【Tricky】。", [], []],
        "技能#贪婪少女#贪欲黑洞": [8701, "贪欲黑洞【回合限定】", "贪欲黑洞", "法术", "普通", "None", "（弃1张法术牌【展示】）我方战绩区+1【水晶】。目标对手弃1张法术牌【展示】；若他不如此做，你对其造成2点法术伤害③，你+1【法术行动】。本回合你无法发动【亡女的金库】。", [["发动【贪欲黑洞】：弃 1 张法术牌【展示】，我方战绩区 +1【水晶】"], ["【贪欲黑洞】：请弃 1 张法术牌【展示】，否则受 2 点法术伤害"]], []],
        "技能#贪婪少女#殓金魔法": [8702, "殓金魔法", "殓金魔法", "响应", "普通", "None", "（你使用【魔弹】造成伤害后发动⑥）我方战绩区+1【水晶】。", [], []],
        "技能#贪婪少女#炼金术": [8703, "炼金术", "炼金术", "响应", "普通", "None", "你的雷系或火系牌可以当【魔弹】使用。", [], []],
        "技能#贪婪少女#亡女的金库": [8704, "亡女的金库", "亡女的金库", "法术", "必杀技", "Crystal", "【水晶】对2名目标对手各造成1点法术伤害③。（若你额外移除【战绩区】所有星石）每移除2星石，伤害+1；（若本次移除的星石中【宝石】>1，伤害结算完成后）将对方1点士气转移给我方。", [["发动【亡女的金库】：是否额外移除战绩区所有星石，每 2 颗伤害 +1"]], [["不额外移除【战绩区】星石"]]],
        "技能#铸律者#神律封锁": [9201, "神律封锁", "神律封锁", "被动", "普通", "None", "（你的【治疗】数未达到上限时）所有未拥有【治疗】的角色手牌上限-1。（每次你【治疗】数增加时）我方士气-1，但至少为1（强制）。", [], []],
        "技能#铸律者#圣血之击": [9202, "圣血之击", "圣血之击", "被动", "普通", "None", "（主动攻击命中时②）本次攻击伤害额外+1，你+1【治疗】。", [], []],
        "技能#铸律者#王车易位": [9203, "王车易位", "王车易位", "法术", "普通", "None", "（移除场上合计2【治疗】）你+2【银制子弹】，移除你的所有基础效果和【治疗】，将你的角色卡替换为【红衣主教】并额外+1【攻击行动】。", [], []],
        "技能#铸律者#罪断豁免": [9204, "罪断豁免", "罪断豁免", "响应", "普通", "None", "（我方非因承受伤害而导致士气下降时，移除X点【圣遗物】）抵御X点士气下降，你+X【银制子弹】。", [], []],
        "技能#铸律者#圣银颂恩": [9205, "圣银颂恩【回合限定】", "圣银颂恩", "响应", "普通", "None", "（【攻击行动】结束时，移除2点【银制子弹】）额外+1【攻击行动】，目标角色+1【治疗】。", [], []],
        "技能#铸律者#王权宝珠": [9206, "王权宝珠", "王权宝珠", "被动", "专属技", "None", "【被动】圣律威压； （此卡转移或放置到你面前时）选择以下一项发动：·（选择1张与此卡上牌种类相同的牌）弃置之【展示】。·摸2张牌【强制】，铸律者阵营士气-1。（若【圣遗物】数<1）移除此卡。 【被动】神言咏赞； （【圣律威压】结算完后）将此卡转移到你右手边最近的玩家面前。（若因此转移至铸律者面前）【铸律者】选择以下一项发动：·将角色卡替换为【红衣主教】，然后移除此卡。·（移除X点【银制子弹】，X<3）目标角色摸X张牌【强制】，然后移除此卡。", [], []],
        "技能#铸律者#信仰重铸": [9207, "信仰重铸【回合限定】", "信仰重铸", "响应", "必杀技", "Crystal", "【水晶】（你的回合结束时，若本回合你未执行【特殊行动】，将1张手牌面朝上放置在【王权宝珠】上【展示】【强制】）你摸1张牌【强制】，你+2【圣遗物】，将【王权宝珠】放置在你面前。", [], []],
        "技能#见习制片#元子吸收": [9301, "元子吸收", "元子吸收", "响应", "普通", "None", "（对目标角色造成法术伤害时发动③）你+1【元子】。", [], []],
        "技能#见习制片#元子重塑": [9302, "元子重塑", "元子重塑", "法术", "普通", "None", "（移除2点【元子】）你弃X张牌，摸X张牌（X<4），额外+1【法术行动】。", [], []],
        "技能#见习制片#元素学徒": [9303, "元素学徒", "元素学徒", "响应", "普通", "None", "你可以使用元素师的独有技。", [], []],
        "技能#见习制片#雷击变异": [9304, "雷击变异", "雷击变异", "被动", "普通", "None", "（你发动【雷击】时）将“我方【战绩区】+1【宝石】”改为“你+1【元子】”", [], []],
        "技能#见习制片#月陨": [9305, "月陨", "月陨", "法术", "必杀技", "Gem", "【宝石】对目标角色造成（X+1）点法术伤害③，X为你剩余的【能量】数。", [], []],
        "技能#记录者#传说之地": [9401, "传说之地", "传说之地", "被动", "普通", "None", "游戏初始时，将牌库顶3张牌面朝上放置在你角色旁【展示】，作为【遗迹】。", [], []],
        "技能#记录者#知行合一": [9402, "知行合一", "知行合一", "法术", "普通", "None", "展示牌堆顶2张牌【展示】；你可选择其中1张牌，将此牌作为相应行动发出并弃1张牌。（结算完成后）将以此法展示的剩余X张牌弃掉，你+X【史料】。", [], []],
        "技能#记录者#稽古识典": [9403, "稽古识典", "稽古识典", "被动", "普通", "None", "（【史料】达到上限时）移除所有【史料】，你弃1张牌，将【史书】加入手牌【强制】。", [], []],
        "技能#记录者#遗迹论破": [9404, "遗迹论破【回合限定】", "遗迹论破", "响应", "普通", "None", "（主动攻击时①，移除与攻击牌同系的X个【遗迹】）本次攻击伤害额外+（X-1）；（若X>1）额外+1【法术行动】；（若因此使【遗迹】数减少为0）我方【战绩区】+1【宝石】。", [], []],
        "技能#记录者#选淬精炼": [9405, "选淬精炼", "选淬精炼", "响应", "普通", "None", "（每当你移除【遗迹】时）将光系与暗系的【遗迹】视为任意系别。", [], []],
        "技能#记录者#秘境万象": [9406, "秘境万象", "秘境万象", "法术", "普通", "None", "（移除【史书】）移除所有【遗迹】，展示牌堆顶牌【展示】直至展示牌中有同系牌为止；将以此法展示的所有X张牌面朝上放置在你角色旁【展示】，作为【遗迹】。（若X>3）对（X-3）名目标角色造成2点法术伤害③。", [], []],
        "技能#记录者#史书": [9407, "史书", "史书", "被动", "专属技", "None", "【被动】以史为镜； （拥有此卡的角色获得）此卡视为地系的幻类命格攻击牌。（此卡被使用、打出、弃置、或者转移拥有者，或因技能放置在角色旁）移除此卡。 【响应】引稽编鉴； （拥有此卡的角色获得，使用此卡进行主动攻击时①）指定攻击目标将1张手牌加入【遗迹】，然后将你手上X张牌与X个【遗迹】交换，X<3。", [], []],
        "技能#记录者#古今互鉴": [9408, "古今互鉴", "古今互鉴", "启动", "必杀技", "Crystal", "【水晶】你+2【史料】；（若你手牌数>1）你可将2张手牌与X个【遗迹】交换，X>0。", [], []],
        "技能#异教徒#异端邪说": [9501, "异端邪说", "异端邪说", "被动", "普通", "None", "游戏初始时，你+1【水晶】。（【末日预言】在场时）你的手牌上限-1。", [], []],
        "技能#异教徒#审判": [9502, "审判", "审判", "响应", "普通", "None", "（你的回合结束时，若本回合你对任意对手造成过伤害③）我方所有角色各弃1张牌【展示】，然后各摸1张牌【强制】，你将其中1张弃牌加入本回合被你伤害过的其中一名对手手牌【强制】（有多名则由你选择一名）。（若【末日预言】在场）将其余弃牌面朝下洗混放置到【末日预言】的【预言】堆顶部作为【预言】。", [[""], ["【审判】：弃 1 张牌【展示】，摸 1 张牌"], ["【审判】：选 1 张弃牌交给目标对手"]], []],
        "技能#异教徒#献祭": [9503, "献祭", "献祭", "启动", "普通", "None", "（仅【末日预言】在场时，指定1种系别）展示【预言】堆顶部1张【预言】【展示】\\n　●（若该【预言】与你指定的系别相同）移除该【预言】，我方【战绩区】+1【宝石】；\\n　●（若不同）将牌堆顶1张牌与该【预言】交换，然后将该【预言】加入你手牌【强制】。", [[""], ["【献祭】：指定 1 种系别，展示【预言】堆顶 1 张"]], [["风系"], ["水系"], ["火系"], ["地系"], ["雷系"], ["光系"], ["暗系"]]],
        "技能#异教徒#末日预言": [9504, "末日预言", "末日预言", "被动", "专属技", "None", "（此卡在场上时，每当有角色因承受伤害而摸牌时）本次摸牌的第1张牌改为自【预言】处获得。（此卡上最后1张【预言】被移除或获得，且结算完后）将此卡翻面。【末日预言】的【预言】上限为6。", [[""], ["【末日预言】的【预言】已空：翻面为【天雷劫火】或【地裂波涛】"]], [["天雷劫火"], ["地裂波涛"]]],
        "技能#异教徒#放逐": [9505, "放逐【回合限定】", "放逐", "法术", "必杀技", "Crystal", "【水晶】（无视你的手牌上限摸6-8张牌【强制】）移除场上所有【末日预言】和【预言】，将1个【末日预言】（背面是【天雷劫火】或【地裂波涛】，由你选择）放置入场，然后将6张手牌面朝下洗混放置到【末日预言】上作为【预言】，额外+1【攻击行动】或【法术行动】。", [[""], ["【放逐】：选择放 1 张【末日预言】入场，并选择 6 张手牌作为【预言】"]], [["摸 6 张牌"], ["摸 7 张牌"], ["摸 8 张牌"], ["天雷劫火"], ["地裂波涛"]]],
        "技能#异教徒#贪婪": [9506, "贪婪", "贪婪", "响应", "必杀技", "Crystal", "【水晶】（与【天雷劫火】或【地裂波涛】同时发动）将“选择以下一项发动”改为“发动以下项目，顺序由你决定”。", [[""], ["【贪婪】：选择发动顺序"]], [["先%s后%s"]]],
        "技能#异教徒#天雷劫火": [9507, "天雷劫火", "天雷劫火", "被动", "专属技", "None", "（此卡展示时）异教徒选择以下一项发动：\\n　●弃X张雷系牌【展示】，摸X张牌【强制】，X最高为4；目标对手弃任意张雷系牌【展示】，然后你对他造成(X+1)点法术伤害③。\\n　●弃X张火系牌【展示】，摸X张牌【强制】，X最高为4；目标对手弃任意张火系牌【展示】，然后你对他造成(X+1)点法术伤害③。", [[""], ["【%s】：选择 1 种系别发动"], ["【%s】：弃最多 %d 张%s系牌【展示】"], ["【%s】：指定 1 名目标对手，他弃牌后你造成 %d 点法术伤害"], ["【%s】：请弃任意张%s系牌【展示】，可不弃"]], [["%s系"]]],
        "技能#异教徒#地裂波涛": [9508, "地裂波涛", "地裂波涛", "被动", "专属技", "None", "（此卡展示时）异教徒选择以下一项发动：\\n　●弃X张地系牌【展示】，摸X张牌【强制】，X最高为4；目标对手弃任意张地系牌【展示】，然后你对他造成(X+1)点法术伤害③。\\n　●弃X张水系牌【展示】，摸X张牌【强制】，X最高为4；目标对手弃任意张水系牌【展示】，然后你对他造成(X+1)点法术伤害③。", [[""], ["【%s】：选择 1 种系别发动"], ["【%s】：弃最多 %d 张%s系牌【展示】"], ["【%s】：指定 1 名目标对手，他弃牌后你造成 %d 点法术伤害"], ["【%s】：请弃任意张%s系牌【展示】，可不弃"]], [["%s系"]]],
        "技能#异教徒#灾殃止息": [9509, "灾殃止息", "灾殃止息", "被动", "专属技", "None", "（异教徒的回合开始时）移除【天雷劫火】和【地裂波涛】。", [], []],
        "技能#传教士#神的门徒": [9601, "神的门徒", "神的门徒", "被动", "普通", "None", "你无法成为【路标】的目标【恒定】，你的行动顺序改为拥有【路标】的角色之后。2V2中此技能无效。", [], []],
        "技能#传教士#信仰之路": [9602, "信仰之路", "信仰之路", "被动", "普通", "None", "（你的第一回合开始时）将【路标】放置在你左手边最近的角色面前。（你的回合结束时，若本回合你未执行【特殊行动】）将【路标】转移到拥有者左手边最近的角色面前。", [], []],
        "技能#传教士#传道": [9603, "传道", "传道", "启动", "普通", "None", "（你摸0-1张牌，弃1张牌【强制】【展示】）你+1【虔诚】，拥有【路标】的角色弃1张牌【展示】，你获得该牌【强制】。（若该牌与你的弃牌系别或者命格相同）你额外+1【虔诚】。", [], []],
        "技能#传教士#启示": [9604, "启示", "启示", "响应", "普通", "None", "（【路标】转移前，移除2点【虔诚】）选择以下一项发动：·目标角色+1【治疗】。·你摸1张牌【强制】【展示】。（若该牌为法术牌或者圣类命格）取消本次转移并移除【路标】，然后将【路标】放置在目标角色面前。", [], []],
        "技能#传教士#事奉": [9605, "事奉", "事奉", "响应", "普通", "None", "（你因自身技能弃的牌置入弃牌堆时，移除你1【治疗】）将该弃牌加入拥有【路标】的角色手牌【强制】。（若没有因此造成该角色阵营士气下降）指定除你外的目标角色+1【治疗】。", [], []],
        "技能#传教士#路标": [9606, "路标", "路标", "响应", "专属技", "None", "【响应】告解式【回合限定】； （此卡被转移至你面前时，你摸2张牌【强制】）我方【战绩区】+1【水晶】，然后将此卡转移至你左手边最近的角色面前，传教士弃1张牌。", [], []],
        "技能#传教士#属灵恩赐": [9607, "属灵恩赐", "属灵恩赐", "启动", "必杀技", "Crystal", "【水晶】你+1【治疗】，弃1张牌。", [], []],
        "技能#传教士#弥撒": [9608, "弥撒", "弥撒", "响应", "必杀技", "Crystal", "【水晶】（【路标】转移或放置后）你+1【虔诚】，选择以下一项发动：·弃1张牌【展示】。（若该牌为【虚弱】、【中毒】或【圣盾】）将该牌放置在拥有【路标】的角色面前作为基础效果。·（将拥有【路标】的角色面前一张基础效果牌收入自己手中）你+1【虔诚】。", [], []],
        "技能#萝莉番长#喧哗上等": [9701, "喧哗上等", "喧哗上等", "被动", "普通", "None", "（攻击命中时②）持续移除牌库顶牌【展示】，直到移除的牌非血类命格或非法术牌，或累积移除三张牌。本次攻击伤害额外+X，X为此法移除的牌库顶牌数。", [], []],
        "技能#萝莉番长#夜露死苦": [9702, "夜露死苦", "夜露死苦", "响应", "普通", "None", "你可以使用狂战士的独有技。", [["发动【夜露死苦】：使用该攻击牌上的狂战士独有技"]], []],
        "技能#萝莉番长#爱死天流": [9703, "爱死天流", "爱死天流", "被动", "普通", "None", "（你发动【血腥咆哮】时）“若攻击的目标拥有的【治疗】为2，则本次攻击强制命中”改为“若攻击的目标拥有【治疗】，则本次攻击无法用【暗灭】应战或使用【圣光】抵挡”。", [], []],
        "技能#萝莉番长#灭茶苦茶": [9704, "灭茶苦茶", "灭茶苦茶", "响应", "必杀技", "None", "（攻击命中后发动②）选择以下一项：【宝石】本次攻击伤害额外+2。【水晶】本次攻击伤害额外+1。", [["发动【灭茶苦茶】：选择支付 1【宝石】伤害 +2 或 1【水晶】伤害 +1"]], [["【宝石】本次攻击伤害 +%d"], ["【水晶】本次攻击伤害 +%d"]]],
        "技能#怠惰少女#别烦我……": [10601, "别烦我……", "别烦我……", "法术", "普通", "None", "（你右手边最近的队友随机丢弃你1张手牌并指定目标对手摸1张牌【强制】）我方【战绩区】+1【水晶】，该对手弃1张法术牌【展示】；（若该对手不如此做）他摸1张牌【强制】，你右手边最近的队友+1【治疗】。", [["发动【别烦我……】：请指定 1 名目标对手"], ["发动【别烦我……】：请弃 1 张法术牌【展示】，否则摸 1 张牌且{src}的右手边队友 +1【治疗】"], ["【别烦我……】：指定目标对手摸1张牌【强制】，我方【战绩区】+1【水晶】，该对手弃1张法术牌【展示】；若该对手不如此做，他摸1张牌【强制】，你+1【治疗】。"]], []],
        "技能#怠惰少女#让我躺平": [10602, "让我躺平", "让我躺平", "响应", "普通", "None", "（你的回合开始时，若你手牌>3）目标队友+1【治疗】，然后跳过你的行动阶段。", [["发动【让我躺平】：选择 1 名队友 +1【治疗】，然后跳过你的行动阶段"]], []],
        "技能#怠惰少女#想用魔弹": [10603, "想用魔弹", "想用魔弹", "响应", "普通", "None", "（你需要使用魔弹时，弃2张同系牌【展示】）视为使用【魔弹】。", [], []],
        "技能#怠惰少女#不想提炼": [10604, "不想提炼", "不想提炼", "被动", "普通", "None", "你无法执行【提炼】。（目标队友指定【提炼】时）你+1【宝石】，移除我方【战绩区】1星石", [["发动【不想提炼】：选择移除我方战绩区 1 颗星石"]], [["我方【战绩区】-1【宝石】"], ["我方【战绩区】-1【水晶】"], ["【战绩区】星石不足，不移除星石"]]],
        "技能#怠惰少女#再睡一下": [10605, "再睡一下", "再睡一下", "被动", "必杀技", "Gem", "【宝石】（你跳过行动阶段后强制触发【强制】）弃1张牌，所有队友各+1【治疗】。（若如此导致有队友【治疗】溢出）我方+1【士气】。", [["发动【再睡一下】：支付 1【宝石】，弃 1 张牌，所有队友各 +1【治疗】"]], []],
        "技能#忌妒少女#醋意羞心": [10701, "醋意羞心", "醋意羞心", "响应", "普通", "None", "（主动攻击未命中时②）目标角色弃1张法术牌【展示】；（若他不如此做）你对他造成2点法术伤害③，我方【战绩区】+1【水晶】。", [["【醋意羞心】：请弃 1 张法术牌【展示】，否则受 2 点法术伤害"]], []],
        "技能#忌妒少女#虚荣掌握": [10702, "虚荣掌握", "虚荣掌握", "响应", "普通", "None", "（主动攻击命中时②）额外+1【法术行动】，本次法术行动只能使用【魔弹】且可以选择逆向传递。", [["发动【虚荣掌握】：额外 +1【法术行动】，本次只能使用【魔弹】，可选择逆向传递"]], []],
        "技能#忌妒少女#相思病": [10703, "相思病", "相思病", "响应", "普通", "None", "你的地系牌或风系牌可以当【魔弹】使用。", [], []],
        "技能#忌妒少女#嫉妒追放": [10704, "嫉妒追放【回合限定】", "嫉妒追放", "响应", "必杀技", "Crystal", "【水晶】（【攻击行动】或【法术行动】后）额外+1【攻击行动】，本次攻击行动只能攻击手牌数大于你的目标对手。", [["发动【嫉妒追放】：支付 1【水晶】，额外 +1【攻击行动】，只能攻击手牌数大于你的对手"]], []],
        "技能#剑之子#倾慕": [10801, "倾慕", "倾慕", "被动", "普通", "None", "（若【剑之魔女】在场）你无法发动【剑守誓言】，你获得【剑之魔女】的【剑影*断念】、【梦想剑】。", [], []],
        "技能#剑之子#风之剑": [10802, "风之剑", "风之剑", "响应", "普通", "None", "（你使用技类命格牌作为主动攻击打出时，移除我方【战绩区】1星石）视为你发动该牌上的剑圣的独有技。", [["发动【风之剑】：移除战绩区 1 颗星石，发动此牌上的剑圣独有技"]], [["移除战绩区 1【宝石】"], ["移除战绩区 1【水晶】"]]],
        "技能#剑之子#剑守誓言": [10803, "剑守誓言", "剑守誓言", "响应", "普通", "None", "（你有主动攻击命中②或任意一方【星杯区】星杯数增加的回合结束后）弃置牌堆顶（X+1）张牌【展示】，X为双方【星杯区】星杯数之和，你可选择其中1张加入你手牌。（若弃牌中有法术牌）你+2【水晶】，立即执行1个你的额外回合，该回合你的攻击伤害额外+1，永久将你的角色卡替换为【风之剑圣】。", [["发动【剑守誓言】：弃置牌库顶 X+1 张牌，可选择其中 1 张加入手牌"]], []],
        "技能#剑之子#剑残影": [10804, "剑残影【回合限定】", "剑残影", "响应", "必杀技", "Crystal", "【水晶】（【攻击行动】结束后发动）目标对手弃1张牌，额外+1【攻击行动】。本回合你的下次主动攻击只能攻击该目标对手。", [["发动【剑残影】：目标对手弃 1 张牌，额外 +1【攻击行动】"]], [["剑残影"]]],
        "技能#仲裁者·圣#神之天平": [10901, "神之天平", "神之天平", "被动", "普通", "None", "游戏初始时你拥有【天平·左】与【天平·右】。", [], []],
        "技能#仲裁者·圣#善恶必计": [10902, "善恶必计【回合限定】", "善恶必计", "响应", "普通", "None", "【回合限定】（我方角色承受伤害⑥并结算完毕后，你将手牌中1张基础牌面朝上【展示】放到【天平·左】或【天平·右】上）你摸1张牌【强制】。", [], []],
        "技能#仲裁者·圣#天平倾倒": [10903, "天平倾倒", "天平倾倒", "被动", "普通", "None", "（你的回合开始时或你的回合结束时，若【天平·左】和【天平·右】上的牌差>1，舍弃牌数多的一方上所有牌）展示牌堆顶4张牌【展示】，你将其中2张加入手牌【强制】并弃掉另外2张牌，你+1【罪】，然后目标队友+2【治疗】。", [], []],
        "技能#仲裁者·圣#神之审判": [10904, "神之审判", "神之审判", "响应", "普通", "None", "（你的回合结束时，若【天平·左】和【天平·右】上的牌数都>2）舍弃【天平·左】与【天平·右】上的所有牌，然后对2名目标角色各造成2点攻击伤害③。", [], []],
        "技能#仲裁者·圣#天平": [10905, "天平", "天平", "被动", "专属技", "None", "【天平·左】/【天平·右】上的牌上限为3；达到上限则无法被再放置新牌。 （天平共有技能）【被动】替罪羔羊； （每当有新牌将被放置在本卡上时，若该卡与本卡上的牌不同系）移除本卡上所有卡，你+1【罪】。 （天平·左）【被动】罪灭之左； （每当本卡上的牌数增加，且增加后本卡上的牌数>1）对（X-1）名目标对手造成1点攻击伤害③，X为本卡上的牌数。 （天平·右）【被动】圣方之右； （每当本卡上的牌被移除且移除牌数>1）你+1【治疗】。", [], []],
        "技能#仲裁者·圣#天罪": [10906, "天罪", "天罪", "启动", "必杀技", "Crystal", "【水晶】你+1【罪】。【横置】持续到本回合结束时，你主动攻击命中时②，可将手牌中2张基本牌面朝上【展示】分别放到【天平·左】和【天平·右】上。【天罪】的效果结束时【重置】。", [], []],
        "技能#仲裁者·圣#罪迟必到": [10907, "罪迟必到", "罪迟必到", "法术", "必杀技", "Crystal", "【水晶】本回合你无法获得【罪】。（你移除所有【罪】）你可将手牌中X张基本牌面朝上【展示】依次放到【天平·左】或【天平·右】上，X为移除的【罪】数量", [], []],
        "技能#红衣主教#圣约银契": [11101, "圣约银契", "圣约银契", "被动", "普通", "None", "（【攻击行动】或【法术行动】结束时）你+1【银制子弹】。", [], []],
        "技能#红衣主教#驱魔式": [11102, "驱魔式", "驱魔式", "启动", "普通", "None", "（移除2点【银制子弹】）我方目标角色弃1张牌【展示】。（若该弃牌为圣类命格）你+1【治疗】，摸1张牌【强制】。", [], []],
        "技能#红衣主教#祷告式": [11103, "祷告式", "祷告式", "响应", "普通", "None", "（主动攻击前①，移除1点【银制子弹】）目标角色+1【治疗】。", [], []],
