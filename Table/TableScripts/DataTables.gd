        "技能表#3302": ["黑暗祭礼", "黑暗祭礼", "普通", "None", "", "被动【黑暗祭礼】：（你的回合结束时，若【鬼火】达到上限）移除所有【鬼火】，对目标角色造成2点法术伤害③", ""],
        "技能表#3303": ["式神降临", "式神降临", "普通", "None", "", "法术【式神降临】【持续】：（弃2张同命格手牌【展示】）【横置】转为【式神形态】，你+1【鬼火】，额外+1【攻击行动】", ""],
        "技能表#3304": ["生命结界", "生命结界", "普通", "None", "", "法术【生命结界】：【水晶】*1 你+1【鬼火】，目标队友+1【宝石】并+1【治疗】；然后你对自己造成X点法术伤害③，X为你的【鬼火】数。（若X为3）因此造成的伤害不会造成我方士气下降。", ""],
        "技能表#3306": ["阴阳转换", "阴阳转换", "普通", "None", "", "响应【阴阳转换】：（应战攻击时①，弃1张与攻击牌同命格的攻击牌【展示】）视为你应战此次攻击，并将本次攻击系别转为与弃牌相同。（若处于【式神形态】，【重置】脱离【式神形态】）本次攻击伤害为X，X为你的【鬼火】数", ""],
        "技能表#3401": ["血色荆棘", "血色荆棘", "普通", "None", "", "被动【血色荆棘】：（攻击命中时②）你+1【鲜血】", ""],
        "技能表#3402": ["赤色一闪", "赤色一闪", "普通", "None", "", "响应【赤色一闪】：（【攻击行动】结束后，移除1点【鲜血】，对自己造成2点法术伤害③）额外+1【攻击行动】", ""],
        "技能表#3403": ["血染蔷薇", "血染蔷薇", "普通", "None", "", "法术【血染蔷薇】：（移除2点【鲜血】）移除目标角色2【治疗】，将我方角色【能量区】的1【水晶】翻面为1【宝石】。（若【血蔷薇庭院】在场）额外对所有角色各造成1点法术伤害③", ""],
        "技能表#3404": ["血气屏障", "血气屏障", "普通", "None", "", "响应【血气屏障】：（任何人对你造成法术伤害③时，移除1点【鲜血】）本次法术伤害③-1，对目标角色造成1点法术伤害③", ""],
        "技能表#3405": ["血蔷薇庭院", "血蔷薇庭院", "普通", "None", "", "启动【血蔷薇庭院】：你选择以下一项发动：#·【水晶】*1 将【血蔷薇庭院】放置于场上，你+2【鲜血】#·【宝石】*1将【血蔷薇庭院】放置于场上，无视你的【鲜血】上限为你+2【鲜血】，但你的【鲜血】数最高为4，你弃到4张牌", ""],
        "技能表#3501": ["新月庇护", "新月庇护", "普通", "None", "", "响应【新月庇护】【持续】：（我方角色因受到伤害造成手牌数超过手牌上限，导致士气即将下降时）【横置】转为【新月形态】，将因此而造成的弃牌面朝下放置于角色旁作为【暗月】，本次士气不会下降", ""],
        "技能表#3502": ["暗月诅咒", "暗月诅咒", "普通", "None", "", "被动【暗月诅咒】：（你毎次移除【暗月】）我方士气-1；（你的【暗月】数为0时）【重置】脱离【暗月形态】", ""],
        "技能表#3503": ["美杜莎之眼", "美杜莎之眼", "普通", "None", "", "响应【美杜莎之眼】：（目标对手攻击时①，移除1个与攻击牌系别相同的【暗月】【展示】）你+1【治疗】，+1【石化】。（若该【暗月】为法术牌）你弃1张牌并额外对目标对手造成1点法术伤害③", ""],
        "技能表#3504": ["月之轮回", "月之轮回", "普通", "None", "", "响应【月之轮回】：（回合结束时）你选择以下一项发动：#·（移除1个【暗月】）目标角色+1【治疗】#·（移除你的1【治疗】）你+1【新月】", ""],
        "技能表#3505": ["月渎", "响应", "普通", "None", "", "", ""],
        "技能表#3506": ["暗月斩", "暗月斩", "普通", "None", "", "响应【暗月斩】：【水晶】*1 （仅【暗月形态】下，主动攻击命中时②，一次移除X个【暗月】，X<3）本次攻击伤害额外+X", ""],
        "技能表#3507": ["苍白之月", "苍白之月", "普通", "None", "", "法术【苍白之月】：【宝石】*1 你选择以下一项发动：#·（移除3点【石化】）额外+1【攻击行动】，本次攻击无法应战。你额外获得一个回合#·移除X点【新月】，你+1【石化】，弃1张牌，对目标对手造成（X+1）点法术伤害③", ""],
        "技能表#3601": ["武者残心", "武者残心", "普通", "None", "", "响应【武者残心】【回合限定】：（【攻击行动】结束时）你+1【残心】", ""],
        "技能表#3602": ["一击无念", "一击无念", "普通", "None", "", "响应【一击无念】：（【攻击行动】结束后，移除4点【残心】）额外+1【攻击行动】，本次攻击无视【圣盾】与【圣光】。（若你处于【御魂流居合形态】）执行此额外攻击时①，你+1【兽魂】且若你使用的攻击牌为技类命格，本次攻击强制命中②", ""],
        "技能表#3603": ["兽魂意念", "兽魂意念", "普通", "None", "", "被动【兽魂意念】：（你毎移除1点【兽魂】）你+1【残心】；（仅【普通形态】下，主动攻击命中时②）你+1【兽魂】", ""],
        "技能表#3604": ["兽魂警戒", "兽魂警戒", "普通", "None", "", "响应【兽魂警戒】【持续】：（其他角色【横置】时，移除1点【兽魂】）【横置】转为【御魂流居合形态】，目标角色弃1张牌【展示】；（若弃牌为法术牌）你+1【兽魂】", ""],
        "技能表#3605": ["兽返", "兽返", "普通", "None", "", "响应【兽返】：（目标角色对你造成法术伤害③时，移除X点【兽魂】）你弃X张牌，他弃1张牌【展示】；（若他的弃牌为法术牌）你+1【兽魂】", ""],
        "技能表#3606": ["逆反居合斩", "响应", "普通", "None", "", "", ""],
        "技能表#3607": ["御魂流居合式", "御魂流居合式", "普通", "None", "", "启动【御魂流居合式】【持续】：【宝石】*1 【横置】转为【御魂流居合形态】，你无视上限+1【兽魂】，并选择摸或弃0~2张牌", ""],
        "技能表#3701": ["天之弓", "被动", "普通", "None", "", "【被动】天之弓：（主动攻击时，若所用攻击牌不是【圣】命格）本次攻击伤害－１。", ""],
        "技能表#3702": ["圣屑飓暴", "法术", "独有技", "None", "", "【法术】圣屑飓暴：（弃２张同系牌[展示]）视为一次圣类命格的该系主动攻击；若所弃的牌为【圣光】，则视为一次圣类命格的暗系主动攻击。", ""],
        "技能表#3703": ["圣煌模式", "法术", "独有技", "Heal", "", "【法术】圣煌模式：（移除２点[治疗]或２点【信仰】）【横置】，额外＋１【法术行动】。", ""],
        "技能表#3704": ["圣光爆裂", "法术", "独有技", "Heal", "", "【法术】圣光爆裂：（移除Ｘ点[治疗]）你＋１【信仰】，对手牌数小于你的目标对手造成２点攻击伤害（＋目标中拥有[治疗]的角色数）；然后你弃Ｘ张牌或摸Ｘ张牌。", ""],
        "技能表#3705": ["圣流星弹", "响应", "普通", "None", "", "【响应】圣流星弹：（特殊行动时，若你处于【横置】）【重置】并＋１[治疗]。", ""],
        "技能表#3706": ["圣煌辉光炮", "法术", "专属技", "Grail", "", "【法术】圣煌辉光炮：所有角色的手牌调整为４张，我方【战绩区】＋１【星杯】，然后选择让我方士气加到与对方相同、或让对方士气减到与我方相同。", ""],
        "技能表#3707": ["自动填充", "启动", "普通", "Gem", "", "【启动】自动填充：（回合结束时）移除１点【宝石】可＋１【水晶】＋２【信仰】或＋２[治疗]；移除１点【水晶】则＋１【信仰】或＋１[治疗]。", ""],
        "技能表#26011": ["魔贯冲击", "响应", "普通", "None", "", "【响应】魔贯冲击：（主动攻击前发动①，移除１个火系【充能】）本次攻击伤害额外＋１，不能攻击手牌达到上限的对手；若命中②，（额外移除１个火系【充能】）本次攻击伤害额外＋１；若未命中②，对对方造成３点法术伤害③；本回合你不能发动【多重射击】。", ""],
        "技能表#26021": ["雷光散射", "法术", "普通", "None", "", "【法术】雷光散射：（移除１个雷系【充能】）对所有对手各造成１点法术伤害③；（若你额外移除Ｘ个雷系【充能】①）指定一名对手，本次对其造成的伤害额外＋Ｘ③。", "【法术】（移除一个雷系【充能】）#对所有对手各造成１点法术伤害③；#（若你额外移除Ｘ个雷系【充能】）指定一名对手，本次对其造成的伤害额外＋Ｘ③。"],
        "技能表#26041": ["充能盖牌", "启动", "必杀技", "Crystal", "", "", ""],
        "技能表#26051": ["魔眼盖牌", "启动", "必杀技", "Gem", "", "", ""],
        "技能表#27051": ["符文改造", "启动", "必杀技", "Gem", "", "【启动】符文改造：【宝石】转为【蓄势迸发形态】，在此形态下你的手牌上限＋２；摸２张牌［强制］并任意调整你的【战纹】和【魔纹】；你的回合结束时脱离【蓄势迸发形态】。", ""],
        "技能表#28081": ["戒骄戒躁", "响应", "必杀技", "Crystal", "", "【响应】戒骄戒躁：【星石】（仅【热血沸腾形态】下，【攻击行动】或【法术行动】结束时发动）脱离【热血沸腾形态】，额外＋１【攻击行动】或【法术行动】。", ""],
        "技能表#29051": ["充盈", "法术", "普通", "None", "", "【法术】充盈：（弃１张法术牌或雷系牌[展示]）所有人各弃一张牌[展示]，我方角色可选择不如此做，除你以外每有人以此法弃１张法术牌或雷系牌，本回合你的下次主动攻击伤害额外＋１。额外＋１【攻击行动】。", "【法术】（弃１张法术牌或雷系牌【展示】）#所有人各弃一张牌【展示】，我方角色可选择不如此做，除你以外每有人以此法弃１张法术牌或雷系牌，本回合你的下次主动攻击伤害额外＋１。额外＋１【攻击行动】。"],
