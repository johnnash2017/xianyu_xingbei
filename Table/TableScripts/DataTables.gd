        "技能表#1703": ["圣洁法典", "法术", "必杀技", "Gem", "", "【法术】圣洁法典：【宝石】（弃Ｘ张异系牌【展示】（Ｘ＞２））Ｙ名角色各＋２[治疗]（Ｙ最高为（Ｘ－２）），并对自己造成（Ｘ－１）点法术伤害③。", "【法术】（必杀技：宝石）#（弃Ｘ张不同系的牌【展示】（Ｘ＞２））#最多（Ｘ－２）名角色各＋２【治疗】，并对自己造成（Ｘ－１）点法术伤害③。"],
        "技能表#1704": ["法术反弹", "响应", "普通", "None", "", "【响应】法术反弹：（你每次承受法术伤害时⑥，若该伤害仅为１点，弃Ｘ张同系牌[展示](Ｘ＞１)）对目标角色造成（Ｘ－１）点法术伤害③，并对自己造成Ｘ点法术伤害③。", ""],
        "技能表#1801": ["风行", "", "", "None", "", "", "【法术】（弃１张风系牌【展示】）#指定２名角色各弃１张牌。"],
        "技能表#1802": ["雷鸣", "", "", "None", "", "", "【法术】（弃１张雷系牌【展示】）#对２名角色各造成１点法术伤害③。"],
        "技能表#1803": ["念咒", "响应", "普通", "None", "", "【响应】念咒：你每次发动【灵符】，可将自己１张手牌作为【妖力】。", ""],
        "技能表#1804": ["百鬼夜行", "响应", "普通", "None", "", "【响应】百鬼夜行：（主动攻击命中后发动②，移除１个【妖力】）对目标角色造成１点法术伤害③；若【妖力】为火系牌，可展示之[展示]，则改为指定２名角色，对除他们以外的其他所有角色各造成１点法术伤害③。", ""],
        "技能表#1805": ["灵力崩解", "响应", "必杀技", "Crystal", "", "【响应】灵力崩解：【星石】（和【灵符－雷鸣】或【百鬼夜行】同时发动）你的本次【灵符－雷鸣】或【百鬼夜行】每次造成的伤害额外＋１。", ""],
        "技能表#1901": ["剑魂守护", "被动", "普通", "None", "", "【被动】剑魂守护：（主动攻击未命中时发动②）将本次打出的攻击牌作为【剑魂】。#若你现有【能量】为单数，你的所有【剑魂】视为【天使之魂】；若为双数，视为【恶魔之魂】；若没有【能量】，则不属于任何一种。", ""],
        "技能表#1902": ["佯攻", "被动", "普通", "None", "", "【被动】佯攻：（主动攻击未命中时发动②）你＋１【剑气】。", ""],
        "技能表#1903": ["剑气斩", "响应", "普通", "None", "", "【响应】剑气斩：（主动攻击命中后发动②，移除Ｘ点【剑气】，Ｘ最高为３）对除你所攻击的目标以外的任意一名角色造成Ｘ点法术伤害③。", ""],
        "技能表#1904": ["天使与恶魔", "", "", "None", "", "", ""],
        "技能表#1905": ["天使之魂", "响应", "普通", "None", "", "【响应】天使之魂：（主动攻击前发动①，移除一个【天使之魂】）本次攻击若命中②，你＋２[治疗]；若未命中②，我方＋１士气；不能和【剑魂守护】同时发动。", ""],
        "技能表#1906": ["恶魔之魂", "响应", "普通", "None", "", "【响应】恶魔之魂：（主动攻击前发动①，移除一个【恶魔之魂】）本次攻击伤害额外＋１；若未命中②，你＋２【剑气】；不能和【剑魂守护】同时发动。", ""],
        "技能表#1907": ["不屈意志", "响应", "必杀技", "Crystal", "", "【响应】不屈意志：【星石】（【攻击行动】结束时发动）你摸１张牌[强制]、＋１【剑气】，额外＋１【攻击行动】。", ""],
        "技能表#2001": ["念气立场", "", "", "None", "", "", ""],
        "技能表#2002": ["蓄力一击", "响应", "普通", "None", "", "【响应】蓄力一击：（主动攻击前发动①，＋１【斗气】）本次攻击伤害额外＋１；若未命中②，对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数。", ""],
        "技能表#2003": ["念弹", "响应", "普通", "None", "", "【响应】念弹：（【法术行动】结束时发动，＋１【斗气】）对目标对手造成１点法术伤害③；若发动前对方[治疗]为０，则对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数。", ""],
        "技能表#2004": ["百式幻龙拳", "启动", "普通", "None", "", "【启动】百式幻龙拳[持续]：（移除３点【斗气】）你的所有主动攻击伤害额外＋２，所有应战攻击伤害额外＋１；#在你接下来的行动阶段，你不能执行【法术行动】和【特殊行动】、你的主动攻击必须以同一名角色为目标，并且不能发动【蓄力一击】；#若不如此做，则取消【百式幻龙拳】效果。", ""],
        "技能表#2005": ["苍炎之魂", "响应", "普通", "None", "", "【响应】苍炎之魂：（主动攻击前发动①，移除１点【斗气】）本次攻击对方不能应战；攻击结束后对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数；不能和【蓄力一击】同时发动。", ""],
        "技能表#2006": ["斗神天驱", "启动", "必杀技", "Crystal", "", "【启动】斗神天驱：【星石】弃到３张牌，你＋２[治疗]。", ""],
        "技能表#2025": ["蓄力一击/苍炎之魂", "响应", "普通", "None", "", "【响应】蓄力一击/苍炎之魂：（主动攻击前发动①，＋１【斗气】）本次攻击伤害额外＋１；若未命中②，对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数。", ""],
        "技能表#2046": ["百式幻龙拳/斗神天驱", "启动", "普通", "Crystal", "", "【启动】百式幻龙拳/斗神天驱[持续]：（移除３点【斗气】）你的所有主动攻击伤害额外＋２，所有应战攻击伤害额外＋１；#在你接下来的行动阶段，你不能执行【法术行动】和【特殊行动】、你的主动攻击必须以同一名角色为目标，并且不能发动【蓄力一击】；#若不如此做，则取消【百式幻龙拳】效果。", ""],
        "技能表#2101": ["挑衅", "法术", "专属技", "None", "", "【法术】挑衅：（移除１点【怒气】，将【挑衅】放置于目标对手面前）你＋１【知性】；该对手在其下个行动阶段必须且只能主动攻击你，否则他跳过该行动阶段，触发后移除此牌。", "【法术】（移除１点【怒气】，将【挑衅】放置于目标对手面前）#你＋１【知性】；该对手在其下个行动阶段必须且只能主动攻击你，否则他跳过该行动阶段，触发后移除此牌。"],
        "技能表#2102": ["禁断之力", "响应", "必杀技", "Crystal", "", "【响应】禁断之力：【星石】（主动攻击命中或未命中后发动②）弃掉你所有手牌[展示]，其中每有１张法术牌，你＋１【怒气】；若未命中②，其中每有１张水系牌，你＋１【知性】；若命中②，其中每有１张火系牌，本次攻击伤害额外＋１，并对自己造成等同于火系牌数量的法术伤害③。", ""],
        "技能表#2103": ["怒吼", "响应", "普通", "None", "", "【响应】怒吼：（主动攻击前发动①，移除１点【怒气】）本次攻击伤害额外＋２；若未命中，你＋１【知性】。", ""],
        "技能表#2104": ["明镜止水", "响应", "普通", "None", "", "【响应】明镜止水：（主动攻击前发动①，移除４点【知性】）本次攻击对方无法应战。", ""],
        "技能表#2105": ["死斗", "响应", "必杀技", "Gem", "", "【响应】死斗：【宝石】（每当你承受法术伤害时发动⑥）你＋３点【怒气】。", ""],
        "技能表#2106": ["精疲力竭", "被动", "普通", "None", "", "【被动】精疲力竭：（发动【禁断之力】后强制触发[强制]）额外＋１【攻击行动】；持续到你的下个行动阶段开始，你的手牌上限恒定为４[恒定]。【精疲力竭】的效果结束时对自己造成３点法术伤害③。", ""],
        "技能表#2201": ["灵魂震爆", "法术", "独有技", "None", "", "【法术】灵魂震爆：（移除３点【黄色灵魂】）对目标角色造成３点法术伤害③，若他手牌＜３且手牌上限＞５，则本次伤害额外＋２。", "【法术】（独有技）#（移除３点【黄色灵魂】）对目标角色造成３点法术伤害③，若他手牌＜３且手牌上限＞５，则本次伤害额外＋２。"],
        "技能表#2202": ["灵魂赐予", "响应", "独有技", "None", "", "【响应】灵魂赐予：（移除３点【蓝色灵魂】）目标角色＋２【宝石】。", "【法术】（独有技）#（移除３点【蓝色灵魂】）目标角色＋２【宝石】。"],
        "技能表#2203": ["灵魂增幅", "启动", "必杀技", "Gem", "", "【启动】灵魂增幅：【宝石】你＋２【黄色灵魂】和２【蓝色灵魂】。", ""],
        "技能表#2204": ["灵魂吞噬", "被动", "普通", "None", "", "【被动】灵魂吞噬：（我方每有１点士气下降）你＋１【黄色灵魂】。", ""],
        "技能表#2205": ["灵魂召还", "法术", "普通", "None", "", "【法术】灵魂召还：（弃Ｘ张法术牌[展示]）你＋（Ｘ＋１）【蓝色灵魂】。", "【法术】（弃Ｘ张法术牌【展示】）#你＋（Ｘ＋１）【蓝色灵魂】。"],
        "技能表#2206": ["灵魂转换", "响应", "普通", "None", "", "【响应】灵魂转换：（你每发动一次主动攻击①）可转换１点你拥有的【灵魂】的颜色。", ""],
        "技能表#2207": ["灵魂镜像", "法术", "普通", "None", "", "【法术】灵魂镜像：（移除２点【黄色灵魂】）你弃３张牌，目标角色摸３张牌[强制]（但最多补到其手牌上限）。", "【法术】（移除２点【黄色灵魂】）#你弃３张牌，目标角色摸３张牌【强制】（但最多补到其手牌上限）。"],
        "技能表#2208": ["灵魂链接", "启动", "专属技", "None", "", "【启动】灵魂链接：（移除１点【黄色灵魂】和１点【蓝色灵魂】，将【灵魂链接】放置于一名队友面前）（每当你们之间将有人承受伤害时⑥，移除Ｘ点【蓝色灵魂】）将Ｘ点伤害转移给另一人，转移后的伤害为法术伤害⑥。", ""],
        "技能表#2209": ["灵魂链接响应", "", "", "None", "", "", ""],
        "技能表#2301": ["血之悲鸣", "法术", "独有技", "None", "", "【法术】血之悲鸣：（仅【流血形态】下发动）对目标角色和自己各造成１～３点法术伤害③，数值由你决定。", "【法术】（独有技）#（仅【流血形态】下发动）对目标角色和自己各造成１～３点法术伤害③，数值由你决定。"],
        "技能表#2302": ["同生共死", "法术", "专属技", "None", "", "【法术】同生共死：（摸２张牌【强制】，将【同生共死】放置于目标角色面前）#在【普通形态】下，你和他手牌上限各－２。#在【流血形态】下，你和他手牌上限各＋１。", "【法术】（摸２张牌【强制】，将【同生共死】放置于目标角色面前）#在【普通形态】下，你和他手牌上限各－２。#在【流血形态】下，你和他手牌上限各＋１。"],
        "技能表#2303": ["血之哀伤", "启动", "普通", "None", "", "【启动】血之哀伤：（对自己造成２点法术伤害③）你选择以下一项发动：#●转移【同生共死】的目标。#●移除【同生共死】。", ""],
        "技能表#2304": ["逆流", "法术", "普通", "None", "", "【法术】逆流：（仅【流血形态】下发动）你弃２张牌，你＋１[治疗]。", "【法术】（仅【流血形态】下发动）#你弃２张牌，你＋１【治疗】。"],
        "技能表#2306": ["流血", "被动", "普通", "None", "", "【被动】流血[持续]：（仅【普通形态】下，当你因承受伤害而导致我方士气下降时强制发动[强制]）转为【流血形态】，你＋１[治疗]。此形态下你的每次回合开始时对自己造成１点法术伤害③。（你的手牌数目＜３时强制触发[强制]）脱离【流血形态】。", ""],
        "技能表#2351": ["血之诅咒", "法术", "必杀技", "Gem", "", "【法术】血之诅咒：【宝石】对目标角色造成２点法术伤害③，你弃３张牌。", "【法术】（必杀技：宝石）#对目标角色造成２点法术伤害③，你弃３张牌。"],
        "技能表#2352": ["血之诅咒弃牌", "", "", "None", "", "", ""],
        "技能表#2401": ["生命之火", "被动", "普通", "None", "", "【被动】生命之火：你的手牌上限最少为３[恒定]，你的手牌上限－Ｘ，Ｘ为你拥有的【蛹】的数量。", ""],
        "技能表#2402": ["舞动", "法术", "普通", "None", "", "【法术】舞动：（摸１张牌[强制]或弃１张牌[强制]）将牌库顶的１张牌作为【茧】。", "【法术】（摸１张牌【强制】或弃１张牌【强制】）#将牌库顶的１张牌作为【茧】。"],
        "技能表#2403": ["毒粉", "响应", "普通", "None", "", "【响应】毒粉：（每当有角色产生１点实际法术伤害时发动⑤，移除１个【茧】）该次伤害额外＋１。", ""],
        "技能表#2404": ["朝圣", "响应", "普通", "None", "", "【响应】朝圣：（每当你承受伤害时发动⑥，移除１个【茧】）抵御１点该来源的伤害。", ""],
        "技能表#2405": ["镜花水月", "响应", "普通", "None", "", "【响应】镜花水月：（每当有角色产生２点实际法术伤害时发动⑤，移除２个同系【茧】[展示]）抵御该次伤害，你对伤害目标造成２次法术伤害③，每次伤害为１点。", ""],
        "技能表#2406": ["凋零", "响应", "普通", "None", "", "【响应】凋零：（你每次移除【茧】时，若为法术牌，可展示之[展示]）你对目标角色造成１点法术伤害③，再对自己造成２点法术伤害③；此技能发动后，直到你的下个回合开始前，对方的士气最少为１[强制]。", ""],
        "技能表#2407": ["蛹化", "法术", "必杀技", "Gem", "", "【法术】蛹化：【宝石】（你＋１【蛹】）将牌库顶的４张牌作为【茧】。", "【法术】（必杀技：宝石）#（你＋１【蛹】）#将牌库顶的４张牌作为【茧】。"],
        "技能表#2408": ["倒逆之蝶", "法术", "必杀技", "Crystal", "", "【法术】倒逆之蝶：【星石】你弃２张牌，再选择以下一项发动：#●对目标角色造成１点法术伤害③，该伤害不能用治疗抵御。#●（移除２个【茧】或对自己造成４点法术伤害③）移除１点【蛹】。", "【法术】（必杀技：星石）# 你弃２张牌，再选择以下一项发动：#●对目标角色造成１点法术伤害③，该伤害不能用治疗抵御。#●（移除２个【茧】或对自己造成４点法术伤害③）移除１个【蛹】。"],
        "技能表#2501": ["神圣追击", "响应", "普通", "None", "", "【响应】神圣追击：（【攻击行动】或【法术行动】结束后，移除你的1[治疗]）额外＋１【攻击行动】。", ""],
        "技能表#2502": ["秩序之印", "法术", "普通", "None", "", "【法术】秩序之印：（摸２张牌［强制］）你＋１［治疗］并＋１【水晶】。", "【法术】（摸２张牌［强制］）你＋１［治疗］并＋１【水晶】。"],
        "技能表#2503": ["和平行者", "被动", "普通", "None", "", "【被动】和平行者：（发动【英灵召唤】后强制触发）转为【英灵形态】；（当你执行主动攻击行动时①）脱离【英灵形态】。", ""],
        "技能表#2504": ["军神威光", "被动", "普通", "None", "", "【被动】军神威光：（回合开始时，若你处于【英灵形态】）你选择以下一项发动：#●你+1【治疗】。#●（移除我方【战绩区】２星石）你无视上限＋２【治疗】。", ""],
        "技能表#2505": ["英灵召唤", "响应", "必杀技", "Crystal", "", "【响应】英灵召唤：【星石】（攻击命中时发动②）本次攻击伤害额外＋１，（若你额外弃１张法术牌［展示］）本次攻击伤害额外＋１。", ""],
        "技能表#2601": ["魔贯冲击", "响应", "普通", "None", "", "【响应】魔贯冲击：（主动攻击前发动①，移除１个火系【充能】）本次攻击伤害额外＋１，不能攻击手牌达到上限的对手；若命中②，（额外移除１个火系【充能】）本次攻击伤害额外＋１；若未命中②，对对方造成３点法术伤害③；本回合你不能发动【多重射击】。", ""],
        "技能表#2602": ["雷光散射", "法术", "普通", "None", "", "【法术】雷光散射：（移除１个雷系【充能】）对所有对手各造成１点法术伤害③；（若你额外移除Ｘ个雷系【充能】①）指定一名对手，本次对其造成的伤害额外＋Ｘ③。", "【法术】（移除一个雷系【充能】）#对所有对手各造成１点法术伤害③；#（若你额外移除Ｘ个雷系【充能】）指定一名对手，本次对其造成的伤害额外＋Ｘ③。"],
        "技能表#2603": ["多重射击", "响应", "普通", "None", "", "【响应】多重射击：（【攻击行动】结束时发动，移除１个风系【充能】）视为额外１次暗系的主动攻击，但不能攻击上次的目标且本次攻击伤害－１；本回合你不能发动【魔贯冲击】。", ""],
        "技能表#2604": ["充能", "启动", "必杀技", "Crystal", "", "【启动】充能：【星石】你弃到四张，摸Ｘ张牌[强制]，可将自己Ｙ张手牌作为【充能】（Ｘ＜５，Ｙ最高为Ｘ）；本回合你不能发动【魔贯冲击】和【雷光散射】。", ""],
        "技能表#2605": ["魔眼", "启动", "必杀技", "None", "", "【启动】魔眼：【宝石】你选择以下一项发动：#●目标角色弃１张牌。#●你摸３张牌【强制】。#然后将自己１张手牌作为【充能】，你＋１【水晶】。", ""],
        "技能表#2606": ["充能&魔眼", "启动", "必杀技", "Crystal", "", "", ""],
        "技能表#2701": ["怒火压制&魔纹融合", "响应", "普通", "None", "", "", ""],
        "技能表#2702": ["怒火压制", "响应", "普通", "None", "", "【响应】怒火压制：（主动攻击未命中时②）翻转１个【战纹】，不能和【魔纹融合】同时发动。", ""],
        "技能表#2703": ["战纹碎击", "响应", "普通", "None", "", "【响应】战纹碎击：（主动攻击命中时②，翻转１个【战纹】，弃Ｘ张同系牌［展示］(Ｘ＞１)）本次攻击伤害额外＋（Ｘ－１），（若你处于【蓄势迸发形态】下，额外翻转Ｙ个【战纹】），本次攻击伤害额外＋Ｙ。", ""],
        "技能表#2704": ["魔纹融合", "响应", "普通", "None", "", "【响应】魔纹融合：（主动攻击未命中时②，翻转１个【魔纹】，弃Ｘ张异系牌［展示］（Ｘ＞１））对本次攻击的角色造成（Ｘ－１）点法术伤害③，（若你处于【蓄势迸发形态】下，额外翻转Ｙ个【魔纹】），本次法术伤害额外＋Ｙ。", ""],
        "技能表#2705": ["符文改造", "启动", "必杀技", "Gem", "", "【启动】符文改造：【宝石】转为【蓄势迸发形态】，在此形态下你的手牌上限＋２；摸２张牌［强制］并任意调整你的【战纹】和【魔纹】；你的回合结束时脱离【蓄势迸发形态】。", ""],
        "技能表#2706": ["双重回响", "响应", "必杀技", "Crystal", "", "", ""],
        "技能表#2801": ["腥红圣约", "响应", "普通", "None", "", "【响应】腥红圣约[回合限定]：（主动攻击时发动①）你＋１[治疗]。", ""],
        "技能表#2802": ["腥红信仰", "被动", "普通", "None", "", "【被动】腥红信仰：你的[治疗]只能抵御自己造成的伤害，你的[治疗]上限＋２。", ""],
        "技能表#2803": ["血腥祷言", "启动", "普通", "None", "", "【启动】血腥祷言：（移除你的Ｘ[治疗]，对自己造成Ｘ点法术伤害③）任意分配Ｘ[治疗]给任意名队友，你＋１【血印】。", ""],
        "技能表#2806": ["杀戮盛宴", "响应", "普通", "None", "", "【响应】杀戮盛宴：（主动攻击命中后发动②，移除１个【血印】，对自己造成４点法术伤害③）本次攻击伤害额外＋２。", ""],
        "技能表#2807": ["热血沸腾", "被动", "普通", "None", "", "【被动】热血沸腾[持续]：（当你因承受伤害而导致我方士气下降时强制发动[强制]）转为【热血沸腾形态】，#该形态下你承受伤害不会造成我方士气下降。在你的回合结束阶段，若你处于此状态，你脱离此状态并＋２[治疗]。", ""],
        "技能表#2808": ["戒骄戒躁", "响应", "必杀技", "Crystal", "", "【响应】戒骄戒躁：【星石】（仅【热血沸腾形态】下，【攻击行动】或【法术行动】结束时发动）脱离【热血沸腾形态】，额外＋１【攻击行动】或【法术行动】。", ""],
        "技能表#2809": ["猩红十字", "", "", "None", "", "", "【法术】（必杀技：星石）#（移除１个【血印】，弃２张法术牌【展示】，对自己造成４点法术伤害③）#对目标角色造成３点法术伤害③。"],
        "技能表#2901": ["暗之解放", "启动", "普通", "None", "", "【启动】暗之解放[持续]：转为【幻影形态】，你的手牌上限恒定为５[恒定]；本回合你的下次主动攻击伤害额外＋２，但不能发动【漆黑之枪】和【充盈】。", ""],
        "技能表#2902": ["幻影星辰", "启动", "普通", "None", "", "【启动】幻影星辰：（仅【幻影形态】下发动，对自己造成２点法术伤害③）脱离【幻影形态】；若没有因此造成我方士气下降，则对目标角色造成２点法术伤害③。", ""],
        "技能表#2904": ["暗之障壁", "响应", "普通", "None", "", "【响应】暗之障壁：（任何人对你造成伤害时发动③）你选择以下一项发动：#●弃Ｘ张法术牌[展示]。#●弃Ｘ张雷系牌[展示]。", ""],
        "技能表#2905": ["充盈", "法术", "普通", "None", "", "【法术】充盈：（弃１张法术牌或雷系牌[展示]）所有人各弃一张牌[展示]，我方角色可选择不如此做，除你以外每有人以此法弃１张法术牌或雷系牌，本回合你的下次主动攻击伤害额外＋１。额外＋１【攻击行动】。", "【法术】（弃１张法术牌或雷系牌【展示】）#所有人各弃一张牌【展示】，我方角色可选择不如此做，除你以外每有人以此法弃１张法术牌或雷系牌，本回合你的下次主动攻击伤害额外＋１。额外＋１【攻击行动】。"],
        "技能表#2906": ["漆黑之枪", "响应", "必杀技", "Crystal", "", "【响应】漆黑之枪：Ｘ【星石】（仅【幻影形态】下，主动攻击命中手牌为１或２的对手后发动②）本次攻击伤害额外＋（Ｘ＋２）。", ""],
        "技能表#3001": ["苍炎法典", "法术", "普通", "None", "", "【法术】苍炎法典：（弃１张火系牌［展示］）对目标角色和自己各造成２点法术伤害③。", "【法术】（弃１张火系牌［展示］）对目标角色和自己造成２点法术伤害③。"],
        "技能表#3002": ["天火断空", "法术", "普通", "None", "", "【法术】天火断空：（弃２张火系牌［展示］，移除１点［重生］）对目标角色和自己各造成３点法术伤害③，（若我方的士气低于对方的士气）每次法术伤害额外＋１［强制］。", "【法术】（弃２张火系牌［展示］，移除１点［重生］）对目标角色和自己各造成３点法术伤害③，（若我方的士气落后）每次法术伤害额外＋１［强制］。"],
        "技能表#3003": ["魔女之怒", "启动", "普通", "None", "", "【启动】魔女之怒：（手牌＜４张时）摸０～２张牌（数值由你决定），持续到你的下个行动阶段开始前，你都处于【烈焰形态】，#在此形态下你的所有除水系和暗系外的攻击牌均视为火系［强制］，你释放【天火断空】时无需移除【重生】，#你的手牌上限＋（Ｘ－２）（Ｘ为你的【重生】数量）", ""],
        "技能表#3004": ["替身玩偶", "响应", "普通", "None", "", "【响应】替身玩偶：（任何人对你造成攻击伤害时③，弃１张法术牌［展示］）目标队友摸１张牌［强制］。", ""],
        "技能表#3005": ["永生银时计", "被动", "普通", "None", "", "【被动】永生银时计：（当你因承受法术伤害而造成士气下降时）你＋１【重生】。", ""],
        "技能表#3006": ["痛苦链接", "法术", "必杀技", "Crystal", "", "【法术】痛苦链接：【星石】对目标对手和自己各造成１点法术伤害③，然后你弃到３张牌。", "【法术】（必杀技：星石）#对目标对手和自己各造成１点法术伤害③，然后你弃到３张牌。"],
