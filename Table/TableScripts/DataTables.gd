        "技能#特殊加工": [1204, "特殊加工", "法术", "必杀技", "【法术】（必杀技：星石）#【回合限定】#将我方【战绩区】的【水晶】全部替换为【宝石】，额外＋１【攻击行动】或【法术行动】。不能和【偷天换日】同时发动。", "Crystal", [], "", "【星石】将我方【战绩区】的【水晶】全部替换为【宝石】，额外＋１【攻击行动】或【法术行动】。不能和【偷天换日】同时发动。"],
        "技能#不朽": [1301, "不朽", "响应", "普通", "", "None", [], "", "（【法术行动】结束时发动）你＋１[治疗]。"],
        "技能#圣渎": [1302, "圣渎", "被动", "普通", "", "None", [], "", "你的[治疗]不能抵御攻击伤害，你的[治疗]上限+3。"],
        "技能#瘟疫": [1303, "瘟疫", "法术", "普通", "【法术】（弃一张地系牌【展示】）#对其他所有角色各造成１点法术伤害③。", "None", [], "", "（弃一张地系牌[展示]）对其他所有角色各造成１点法术伤害③。"],
        "技能#死亡之触": [1304, "死亡之触", "法术", "普通", "【法术】（移除你面前的Ａ【治疗】并弃Ｂ张同系牌【展示】，Ａ、Ｂ的数值由你决定，但每项最少为２）#对目标角色造成（Ａ＋Ｂ－３）点法术伤害③；不能和【不朽】同时发动。", "None", [], "", "（移除你面前的a[治疗]并弃b张同系牌[展示]，a,b的数值由你决定，但每项最少为２）对目标角色造成(a+b-3)点法术伤害③；不能和【不朽】同时发动。\""],
        "技能#剧毒新星": [1305, "剧毒新星", "法术", "必杀技", "【法术】（必杀技：宝石）#对其他所有角色各造成２点法术伤害③，你＋１【治疗】。", "Gem", [], "", "【宝石】对其他所有角色各造成２点法术伤害③，你＋１[治疗]。"],
        "技能#仲裁法则": [1406, "仲裁法则", "被动", "普通", "", "None", [], "", "游戏初始时，你＋２【水晶】。"],
        "技能#仪式中断": [1401, "仪式中断", "启动", "普通", "", "None", [], "", "（仅【审判形态】下发动）脱离【审判形态】，我方【战绩区】＋１【宝石】。"],
        "技能#末日审判": [1403, "末日审判", "法术", "普通", "【法术】（移除所有【审判】）#对目标角色造成等量的法术伤害③；在你的行动阶段开始时，若【审判】已达到上限，该行动阶段你必须发动【末日审判】。", "None", [], "", "（移除所有【审判】）对目标角色造成等量的法术伤害③。在你的行动阶段开始时，若【审判】已达到上限，该行动阶段你必须发动【末日审判】。"],
        "技能#审判浪潮": [1404, "审判浪潮", "被动", "普通", "", "None", [], "", "（你每承受一次伤害⑥）你＋１【审判】。"],
        "技能#仲裁仪式": [1402, "仲裁仪式", "启动", "必杀技", "", "Gem", [], "", "【宝石】转为【审判形态】，你的手牌上限恒定为５[恒定]；此形态下每次在你的回合开始时，你＋１【审判】。"],
        "技能#判决天平": [1405, "判决天平", "法术", "必杀技", "【法术】（必杀技：星石）#你＋１【审判】，再选择以下一项发动：#●弃掉你的所有牌#●将你的手牌补到上限【强制】，我方【战绩区】＋１【宝石】。", "None", [], "", "【星石】你＋１【审判】，再选择以下一项发动：#●弃掉你的所有手牌；#●将你的手牌补到上限【强制】，我方【战绩区】＋１【宝石】。"],
        "技能#神圣启示": [1501, "神圣启示", "响应", "普通", "", "None", [], "", "（【特殊行动】结束时发动）你＋１[治疗]。"],
        "技能#神圣祈福": [1502, "神圣祈福", "法术", "普通", "【法术】（弃２张法术牌【展示】）#你＋２【治疗】。", "None", [], "", "（弃２张法术牌[展示]）你＋２[治疗]。"],
        "技能#水之神力": [1503, "水之神力", "法术", "普通", "【法术】（弃１张水系牌【展示】）#将手中的一张牌交给目标队友【强制】，你和他各＋１【治疗】。", "None", [["请选择 {n} 张手牌交给 {dst}"]], "", "（弃１张水系牌[展示]）将手中的一张牌交给目标队友[强制]，你和他各＋１[治疗]。"],
        "技能#圣使守护": [1504, "圣使守护", "被动", "普通", "", "None", [], "", "你的[治疗]上限＋４，你每次用[治疗]去抵御伤害时，最多只能使用１点。"],
        "技能#神圣契约": [1505, "神圣契约", "启动", "必杀技", "", "Crystal", [["发动【神圣契约】：把治疗转移给队友"]], "", "【星石】将你的Ｘ[治疗]转移给一名队友，以此法所转移的[治疗]无视他的[治疗]上限，但他的[治疗]最高为４。"],
        "技能#神圣领域": [1506, "神圣领域", "法术", "必杀技", "【法术】（必杀技：星石）#你弃２张牌，再选择一项：#●（移除你的１【治疗】）对目标角色造成２点法术伤害③。#●你＋２【治疗】，目标队友＋１【治疗】。", "None", [], "", "【星石】你弃２张牌，再选择以下一项发动：#●（移除你的１[治疗]）对目标角色造成２点法术伤害③。#●你＋２[治疗]，目标队友＋１[治疗]。"],
        "技能#光辉信仰": [1604, "光辉信仰", "法术", "普通", "【法术】（仅【祈祷形态】下发动，移除１点【祈祷符文】）#你弃２张牌，我方【战绩区】＋１【宝石】，目标队友＋１【治疗】。", "None", [], "", "（仅【祈祷形态】下发动，移除１点【祈祷符文】）你弃２张牌，我方【战绩区】＋１【宝石】，目标队友＋１[治疗]。"],
        "技能#黑暗诅咒": [1605, "黑暗诅咒", "法术", "普通", "【法术】（仅【祈祷形态】下发动，移除１点【祈祷符文】）#对目标角色和自己各造成２点法术伤害③。", "None", [], "", "（仅【祈祷形态】下发动，移除１点【祈祷符文】）对目标角色和自己各造成２点法术伤害③。"],
        "技能#威力赐福": [1602, "威力赐福", "法术", "独有技", "【法术】（独有技）#（将【威力赐福】放置于目标队友面前）该队友获得#（攻击命中后可以移除此牌发动②）：本次攻击伤害额外＋２。", "None", [["发动【威力赐福】：本次攻击伤害 +2"]], "", "（将【威力赐福】放置于目标队友面前）该队友获得：（攻击命中后可以移除此牌发动②）：本次攻击伤害额外＋２。"],
        "技能#迅捷赐福": [1601, "迅捷赐福", "法术", "独有技", "【法术】（独有技）#（将【迅捷赐福】放置于目标队友面前）该队友获得#（【法术行动】或【攻击行动】结束时可以移除此牌发动）：额外＋１【攻击行动】。", "None", [], "", "（将【迅捷赐福】放置于目标队友面前）该队友获得：（【法术行动】或【攻击行动】结束时，移除此牌发动）：额外＋１【攻击行动】。"],
        "技能#祈祷": [1603, "祈祷", "启动", "必杀技", "", "Gem", [], "", "【宝石】转为【祈祷形态】，此形态下（你每发动一次主动攻击①），你＋２【祈祷符文】。"],
        "技能#法力潮汐": [1606, "法力潮汐", "响应", "必杀技", "", "Crystal", [], "", "【星石】（【法术行动】结束后发动）额外＋１【法术行动】。##＊【祈祷符文】为祈祷师专有指示物，上限为３。"],
        "技能#智慧法典": [1701, "智慧法典", "被动", "普通", "", "None", [], "", "你的【能量】上限＋１；（你每次承受法术伤害时⑥，若该伤害＞３）你＋２【宝石】。"],
        "技能#法术反弹": [1704, "法术反弹", "响应", "普通", "", "None", [["发动【法术反弹】：弃 2 张以上同系牌并选目标"]], "", "（你每次承受法术伤害时⑥，若该伤害仅为１点，弃Ｘ张同系牌[展示](Ｘ＞１)）对目标角色造成（Ｘ－１）点法术伤害③，并对自己造成Ｘ点法术伤害③。"],
        "技能#魔道法典": [1702, "魔道法典", "法术", "必杀技", "【法术】（必杀技：宝石）#（弃Ｘ张不同系的牌【展示】（Ｘ＞１））#对目标角色与自己各造成（Ｘ－１）点法术伤害③。", "Gem", [], "", "【宝石】（弃Ｘ张异系牌【展示】（Ｘ＞１））对目标角色与自己各造成（Ｘ－１）点法术伤害③。"],
        "技能#圣洁法典": [1703, "圣洁法典", "法术", "必杀技", "【法术】（必杀技：宝石）#（弃Ｘ张不同系的牌【展示】（Ｘ＞２））#最多（Ｘ－２）名角色各＋２【治疗】，并对自己造成（Ｘ－１）点法术伤害③。", "Gem", [], "", "【宝石】（弃Ｘ张异系牌【展示】（Ｘ＞２））Ｙ名角色各＋２[治疗]（Ｙ最高为（Ｘ－２）），并对自己造成（Ｘ－１）点法术伤害③。"],
        "技能#灵符-雷鸣": [1802, "灵符-雷鸣", "法术", "普通", "【法术】（弃１张雷系牌【展示】）#对２名角色各造成１点法术伤害③。", "None", [], "", "（弃1张雷系牌【展示】）对任意2名角色各造成1点法术伤害③。"],
        "技能#灵符-风行": [1801, "灵符-风行", "法术", "普通", "【法术】（弃１张风系牌【展示】）#指定２名角色各弃１张牌。", "None", [], "", "（弃1张风系牌【展示】）指定2名角色各弃1张牌。"],
        "技能#念咒": [1803, "念咒", "响应", "普通", "", "None", [["发动【念咒】：把 {n} 张手牌作【妖力】"]], "", "【触发时机】每次发动【灵符】时\\n【效果】可将自己１张手牌作为【妖力】。"],
        "技能#百鬼夜行": [1804, "百鬼夜行", "响应", "普通", "", "None", [["发动【百鬼夜行】：移除 {n} 个【妖力】"]], "", "（主动攻击命中后发动②，移除1个【妖力】）对目标角色造成1点法术伤害③；（若【妖力】为火系牌，可展示之【展示】）改为指定2名角色，对除他们以外的其他所有角色各造成1点法术伤害③。"],
        "技能#灵力崩解": [1805, "灵力崩解", "响应", "必杀技", "", "Crystal", [], "", "【触发时机】和【灵符－雷鸣】或【百鬼夜行】同时发动\\n【代价】【星石】*1\\n【效果】你的本次【灵符－雷鸣】或【百鬼夜行】每次造成的伤害额外＋１。"],
        "技能#剑魂守护": [1901, "剑魂守护", "被动", "普通", "", "None", [], "", "(主动攻击未命中时发动②)将本次打出的攻击牌面朝下放置在你的角色旁，作为【剑魂】。若你现有【能量】为单数，你的所有【剑魂】视为【天使之魂】；若为双数，视为【恶魔之魂】；若没有【能量】，则不属于任何一种。(若【剑魂】达到上限)你不能发动【剑魂守护】。"],
        "技能#佯攻": [1902, "佯攻", "被动", "普通", "", "None", [], "", "（主动攻击未命中时发动②）你＋１【剑气】。"],
        "技能#剑气斩": [1903, "剑气斩", "响应", "普通", "", "None", [["发动【剑气斩】：选 1 名其他角色"]], "", "（主动攻击命中后发动②，移除Ｘ点【剑气】，Ｘ最高为３）对除你所攻击的目标以外的任意一名角色造成Ｘ点法术伤害③。"],
        "技能#天使之魂": [1905, "天使之魂", "响应", "普通", "", "None", [["发动【天使之魂】：移除 {n} 张【剑魂】"]], "", "（主动攻击前发动①，移除一个【天使之魂】）本次攻击若命中②，你＋２[治疗]；若未命中②，我方＋１士气；不能和【剑魂守护】同时发动。"],
        "技能#恶魔之魂": [1906, "恶魔之魂", "响应", "普通", "", "None", [["发动【恶魔之魂】：移除 {n} 张【剑魂】"]], "", "（主动攻击前发动①，移除一个【恶魔之魂】）本次攻击伤害额外＋１；若未命中②，你＋２【剑气】；不能和【剑魂守护】同时发动。"],
        "技能#不屈意志": [1907, "不屈意志", "响应", "必杀技", "", "Crystal", [], "", "【星石】（【攻击行动】结束时发动）你摸１张牌[强制]、＋１【剑气】，额外＋１【攻击行动】。"],
        "技能#天使与恶魔": [1904, "天使与恶魔", "", "", "", "None", [], "", ""],
        "技能#念气力场": [2001, "念气力场", "被动", "普通", "", "None", [], "", "所有对你造成的伤害每次最高为４点③。"],
        "技能#蓄力一击": [2002, "蓄力一击", "响应", "普通", "", "None", [], "", "（主动攻击前发动①，＋１【斗气】）本次攻击伤害额外＋１；若未命中②，对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数。"],
        "技能#念弹": [2003, "念弹", "响应", "普通", "", "None", [["发动【念弹】：选 1 名对手"]], "", "（【法术行动】结束时发动，＋１【斗气】）对目标对手造成１点法术伤害③；若发动前对方[治疗]为０，则对自己造成Ｘ点法术伤害③，Ｘ为你拥有的【斗气】数。"],
        "技能#百式幻龙拳": [2004, "百式幻龙拳", "启动", "普通", "", "None", [["发动【百式幻龙拳】：移除 3 点【斗气】"]], "", "(移除3点【斗气】)【横置】你的所有主动攻击伤害额外+2，所有应战攻击伤害额外+1；在你接下来的行动阶段，你不能执行【法术行动】和【特殊行动】；你的主动攻击必须以同一名角色为目标，并且不能发动【蓄力一击】；若不如此做，则取消【百式幻龙拳】的效果并【重置】。"],
        "技能#气绝崩击": [2005, "气绝崩击", "响应", "普通", "", "None", [], "", "(主动攻击前发动①，移除1点【斗气】)本次攻击对手无法应战，攻击后对自己造成X点法术伤害③，X为你的【斗气】数，不能发动【蓄力一击】。"],
        "技能#斗神天驱": [2006, "斗神天驱", "启动", "必杀技", "", "Crystal", [["发动【斗神天驱】：把手牌弃到 3 张"]], "", "【星石】弃到３张牌，你＋２[治疗]。"],
        "技能#勇者之心": [2107, "勇者之心", "被动", "普通", "", "None", [], "", ""],
        "技能#怒吼": [2103, "怒吼", "响应", "普通", "", "None", [], "", "（主动攻击前发动①，移除１点【怒气】）本次攻击伤害额外＋２；若未命中，你＋１【知性】。"],
        "技能#精疲力竭": [2106, "精疲力竭", "被动", "普通", "", "None", [], "", "（发动【禁断之力】后强制触发[强制]）额外＋１【攻击行动】；持续到你的下个行动阶段开始，你的手牌上限恒定为４[恒定]。"],
        "技能#明镜止水": [2104, "明镜止水", "响应", "普通", "", "None", [], "", "（主动攻击前发动①，移除４点【知性】）本次攻击对方无法应战。"],
