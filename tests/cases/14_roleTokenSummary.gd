extends 自检用例
## 用例 14：角色悬停说明右下角的「专属标识物」一览
## 名字 + 上限，多个用逗号分隔，上限 99 表示没有上限、显示为无限符号 ∞。

func _init() -> void:
	名称 = "角色标识物一览"


func 跑() -> void:
	await 等帧(1)
	# 灵魂术士（22）：两枚，逗号分隔
	检(角色技能提示.标识物一览(22) == "专属标识物【黄魂】上限为6，【蓝魂】上限为6",
		"灵魂术士的标识物一览不对：%s" % 角色技能提示.标识物一览(22))
	# 蝶舞者（24）：蛹的上限在角色表里配的是 99，应显示 ∞
	检(角色技能提示.标识物一览(24) == "专属标识物【蛹】上限为∞，【茧】上限为8",
		"蝶舞者的标识物一览不对：%s" % 角色技能提示.标识物一览(24))
	# 月之女神（35）：三枚都列出来
	检(角色技能提示.标识物一览(35) == "专属标识物【新月】上限为2，【石化】上限为3，【暗月】上限为∞",
		"月之女神的标识物一览不对：%s" % 角色技能提示.标识物一览(35))
	# 风之剑圣（1）没有标识物：不出现这一行
	检(角色技能提示.标识物一览(1) == "", "没有标识物的角色不该有一览")
	# 悬浮提示里这一行必须靠右、并且放在最末（提示框的右下角）
	var 文本: String = 角色技能提示.悬浮提示(22)
	检(文本.substr(文本.rfind("\n") + 1).begins_with("[right]"),
		"标识物一览没有右对齐：%s" % 文本.substr(文本.rfind("\n") + 1))
	检(文本.ends_with("[/right]"), "标识物一览必须是提示的最后一段")

	# 角色名 = 职业名 + 姓名 + 势力（角色表的「势力」列）；右上角星数用项目字体能显示的 ★
	var 标题文本: String = 角色技能提示.悬浮提示(1)
	检(Data.role_faction(1) == "战技殿堂", "角色 1 的势力应是战技殿堂：%s" % Data.role_faction(1))
	检(标题文本.contains("[font_size=36]风之剑圣 威斯特姆[/font_size] [font_size=18]战技殿堂[/font_size]"),
		"悬停说明的角色名应带势力：空格隔开、势力字号减半：%s" % 标题文本.substr(0, 160))
	检(角色技能提示.星数文本(1) == "★3", "整数星数格式不对：%s" % 角色技能提示.星数文本(1))
	检(角色技能提示.星数文本(9) == "★3.5", "半星格式不对：%s" % 角色技能提示.星数文本(9))
	检(角色技能提示.星数文本(23) == "★5", "五星格式不对：%s" % 角色技能提示.星数文本(23))
	检(角色技能提示.星数文本(0) == "", "无星数角色不应显示星数")

	# 角色说明框的描边按命格换色：血红 / 咏橙 / 技绿 / 圣蓝 / 幻紫
	var 色血: Color = 角色技能提示.描边颜色(2)    # 狂战士：血
	var 色咏: Color = 角色技能提示.描边颜色(8)    # 魔法少女：咏
	var 色技: Color = 角色技能提示.描边颜色(1)    # 风之剑圣：技
	var 色圣: Color = 角色技能提示.描边颜色(6)    # 圣女：圣
	var 色幻: Color = 角色技能提示.描边颜色(4)    # 封印师：幻
	检(色血.r > 0.7 and 色血.g < 0.4 and 色血.b < 0.4, "血脉描边应是红色：%s" % str(色血))
	检(色咏.r > 0.9 and 色咏.g > 0.5 and 色咏.g < 0.75 and 色咏.b < 0.3,
		"咏命格描边应是橙色：%s" % str(色咏))
	检(色技.g > 0.7 and 色技.r < 0.5 and 色技.b < 0.5, "技命格描边应是绿色：%s" % str(色技))
	检(色圣.b > 0.9 and 色圣.r < 0.5, "圣命格描边应是蓝色：%s" % str(色圣))
	检(色幻.b > 0.9 and 色幻.r > 0.6 and 色幻.g < 0.5, "幻命格描边应是紫色：%s" % str(色幻))
	检(角色技能提示.描边颜色(9999).a == 0.0, "角色表里没有的角色应返回透明哨兵、用提示框默认描边")
	检(is_equal_approx(色血.a, 0.5) and is_equal_approx(色技.a, 0.5) and is_equal_approx(色幻.a, 0.5),
		"命格描边统一 50% 不透明度：血 %s / 技 %s / 幻 %s" % [str(色血), str(色技), str(色幻)])

	var 提示框预制: PackedScene = load("res://scenes/prefabs/ui/TipBox.tscn")
	var 提示框: Node = 提示框预制.instantiate()
	检(提示框.get("星数标签") != null, "TipBox 的星数标签没有绑定")
	检(提示框.get_node_or_null("框/文本/星数") != null, "TipBox 缺右上角星数节点")
	# 进树后 _ready 才会记下默认描边；再走真实入口，验证描边确实换了 / 能换回来
	var 宿主: Control = Control.new()
	宿主.size = Vector2(1280, 720)
	add_child(宿主)
	宿主.add_child(提示框)
	await 等帧(1)
	var 说明框: 说明提示框 = 提示框 as 说明提示框
	var 底板: StyleBoxFlat = 说明框.框.get_theme_stylebox("panel") as StyleBoxFlat
	检(底板 != null, "提示框底板不是 StyleBoxFlat，没法按命格换描边")
	说明框.显示角色说明(1, Rect2(100, 100, 64, 64))
	await 等帧(2)
	if 底板 != null:
		检(底板.border_color.is_equal_approx(色技),
			"角色说明的描边应换成技命格的绿色：%s" % str(底板.border_color))
	# 普通说明（技能按钮 / 状态图标）不该继承角色说明的描边色
	说明框.显示("测试用一句话", Rect2(100, 100, 64, 64), 300.0, 16)
	if 底板 != null:
		检(not 底板.border_color.is_equal_approx(色技), "普通说明应恢复默认描边")
	说明框.queue_free()
	宿主.queue_free()
