extends 自检用例
## 用例 14：角色悬停说明右下角的「专属标识物」一览
## 名字 + 上限，多个用逗号分隔，上限 99 表示没有上限、显示为无限符号 ∞。

func _init() -> void:
	名称 = "角色标识物一览"


func 跑() -> void:
	await 等帧(1)
	# 灵魂术士（22）：两枚，逗号分隔
	检(角色技能提示.标识物一览(22) == "专属标识物【黄魂】上限为6，【蓝魂】上限为6",
		"灵魂术士的标识物一览不对：%s" % 角色技能提示.标识物一览(22))
	# 蝶舞者（24）：蛹的上限在角色表里配的是 99，应显示 ∞
	检(角色技能提示.标识物一览(24) == "专属标识物【蛹】上限为∞，【茧】上限为8",
		"蝶舞者的标识物一览不对：%s" % 角色技能提示.标识物一览(24))
	# 月之女神（35）：三枚都列出来
	检(角色技能提示.标识物一览(35) == "专属标识物【新月】上限为2，【石化】上限为3，【暗月】上限为∞",
		"月之女神的标识物一览不对：%s" % 角色技能提示.标识物一览(35))
	# 风之剑圣（1）没有标识物：不出现这一行
	检(角色技能提示.标识物一览(1) == "", "没有标识物的角色不该有一览")
	# 悬浮提示里这一行必须靠右、并且放在最末（提示框的右下角）
	var 文本: String = 角色技能提示.悬浮提示(22)
	检(文本.substr(文本.rfind("\n") + 1).begins_with("[right]"),
		"标识物一览没有右对齐：%s" % 文本.substr(文本.rfind("\n") + 1))
	检(文本.ends_with("[/right]"), "标识物一览必须是提示的最后一段")

	# 角色名 = 职业名 + 姓名；右上角星数用项目字体能显示的 ★
	var 标题文本: String = 角色技能提示.悬浮提示(1)
	检(标题文本.contains("风之剑圣 威斯特姆"), "悬停说明的角色名没有带姓名：%s" % 标题文本.substr(0, 80))
	检(角色技能提示.星数文本(1) == "★3", "整数星数格式不对：%s" % 角色技能提示.星数文本(1))
	检(角色技能提示.星数文本(9) == "★3.5", "半星格式不对：%s" % 角色技能提示.星数文本(9))
	检(角色技能提示.星数文本(23) == "★5", "五星格式不对：%s" % 角色技能提示.星数文本(23))
	检(角色技能提示.星数文本(0) == "", "无星数角色不应显示星数")

	var 提示框预制: PackedScene = load("res://scenes/prefabs/ui/TipBox.tscn")
	var 提示框: Node = 提示框预制.instantiate()
	检(提示框.get("星数标签") != null, "TipBox 的星数标签没有绑定")
	检(提示框.get_node_or_null("框/文本/星数") != null, "TipBox 缺右上角星数节点")
	提示框.free()
