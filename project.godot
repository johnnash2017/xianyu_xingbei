; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="杂鱼星杯"
config/version="1.0.47"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Cfg="*res://scripts/client/config.gd"
SteamNet="*res://scripts/net/steam_net.gd"
Data="*res://scripts/data/data_interface.gd"
Net="*res://scripts/net/net_manager.gd"
Logic="*res://scripts/client/client_logic.gd"
UI="*res://scripts/ui/ui_manager.gd"
Art="*res://scripts/ui/art.gd"
Audio="*res://scripts/client/audio.gd"
AssetIndex="*res://scripts/framework/AssetIndex.gd"
MessageSystem="*res://scripts/framework/MessageSystem.gd"
ClickDust="*res://scripts/effects/clickStardust.gd"
EffectWarmer="*res://scripts/effects/effect_warmer.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/excel_to_gd/plugin.cfg", "res://addons/gd_alias/plugin.cfg", "res://addons/label_font_auto_sizer/plugin.cfg", "res://addons/resdsp/plugin.cfg", "res://addons/version_tool/plugin.cfg", "res://addons/multi_open/plugin.cfg")

[gui]

theme/custom="res://assets/textures/lobby/ui_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
