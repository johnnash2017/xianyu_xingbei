## 协议号 —— 对应 C# 的 ProtoNameIds 枚举（数值必须一致）
##
## 注意：这套编号是「线上协议号」，与客户端内部事件枚举 Msg.T 的编号**并不相同**
## （例如线上 GAMEINFO=16，而 Msg.T.GAMEINFO=28，恰好与线上 ROOMINFO 撞号）。
## 收包派发时必须先经 Msg.PROTO_TO_EVENT 映射，再交给 MessageSystem，
## 否则会出现「房间信息被当成对局信息」这类错位。
class_name ProtoNameIds
extends RefCounted

const REGISTERREQUEST := 1
const REGISTERRESPONSE := 2
const LOGINREQUEST := 3
const LOGINRESPONSE := 4
const LOGOUTREQUEST := 5
const LOGOUTRESPONSE := 6
const ROOMLISTREQUEST := 7
const ROOMLISTRESPONSE := 8
const CREATEROOMREQUEST := 9
const ENTERROOMREQUEST := 10
const ENTERROOMRESPONSE := 10
const LEAVEROOMREQUEST := 12
const JOINTEAMREQUEST := 13
const READYFORGAMEREQUEST := 14
const SINGLEPLAYERINFO := 15
const GAMEINFO := 16
const TALK := 17
const GOSSIP := 18
const ERROR := 19
const HEARTBEAT := 20
const LEADERREQUEST := 21
const LEADERRESPONSE := 22
const POLLINGREQUEST := 23
const POLLINGRESPONSE := 24
const HERORANKREQUEST := 25
const HERORANKRESPONSE := 26
const RANKINGREQUEST := 27
const ROOMINFO := 28
const RANKINGRESPONSE := 29
const RANKINFOREQUEST := 30
const RANKINFORESPONSE := 31
const GIVEUPREQUEST := 32
const GIVEUPRESPONSE := 33
const ROLEREQUEST := 101
const PICKBAN := 102
const ACTION := 103
const RESPOND := 104
const COMMANDREQUEST := 106
const ERRORINPUT := 107
const HITMSG := 108
const TURNBEGIN := 109
const CARDMSG := 110
const HURTMSG := 111
const SKILLMSG := 112

const NAMES := {
	REGISTERREQUEST: "REGISTERREQUEST", REGISTERRESPONSE: "REGISTERRESPONSE",
	LOGINREQUEST: "LOGINREQUEST", LOGINRESPONSE: "LOGINRESPONSE",
	LOGOUTREQUEST: "LOGOUTREQUEST", LOGOUTRESPONSE: "LOGOUTRESPONSE",
	ROOMLISTREQUEST: "ROOMLISTREQUEST", ROOMLISTRESPONSE: "ROOMLISTRESPONSE",
	CREATEROOMREQUEST: "CREATEROOMREQUEST", ENTERROOMREQUEST: "ENTERROOMREQUEST",
	LEAVEROOMREQUEST: "LEAVEROOMREQUEST", JOINTEAMREQUEST: "JOINTEAMREQUEST",
	READYFORGAMEREQUEST: "READYFORGAMEREQUEST", SINGLEPLAYERINFO: "SINGLEPLAYERINFO",
	GAMEINFO: "GAMEINFO", TALK: "TALK", GOSSIP: "GOSSIP", ERROR: "ERROR",
	HEARTBEAT: "HEARTBEAT", LEADERREQUEST: "LEADERREQUEST", LEADERRESPONSE: "LEADERRESPONSE",
	POLLINGREQUEST: "POLLINGREQUEST", POLLINGRESPONSE: "POLLINGRESPONSE",
	HERORANKREQUEST: "HERORANKREQUEST", HERORANKRESPONSE: "HERORANKRESPONSE",
	RANKINGREQUEST: "RANKINGREQUEST", ROOMINFO: "ROOMINFO", RANKINGRESPONSE: "RANKINGRESPONSE",
	RANKINFOREQUEST: "RANKINFOREQUEST", RANKINFORESPONSE: "RANKINFORESPONSE",
	GIVEUPREQUEST: "GIVEUPREQUEST", GIVEUPRESPONSE: "GIVEUPRESPONSE",
	ROLEREQUEST: "ROLEREQUEST", PICKBAN: "PICKBAN", ACTION: "ACTION", RESPOND: "RESPOND",
	COMMANDREQUEST: "COMMANDREQUEST", ERRORINPUT: "ERRORINPUT", HITMSG: "HITMSG",
	TURNBEGIN: "TURNBEGIN", CARDMSG: "CARDMSG", HURTMSG: "HURTMSG", SKILLMSG: "SKILLMSG",
}

static func name_of(id: int) -> String:
	return NAMES.get(id, str(id))
