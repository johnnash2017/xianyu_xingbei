## 版本值来自设计表角色表的枚举；房间用位掩码记录「开启了哪些版本」，
## 值必须与 Table/Design/设计表.xlsx 的枚举保持一致（未定义 0 不进候选）。
const ROLE_VERSION_NAMES: Dictionary = {
	1: "十周年",
	2: "异端业火",
	3: "神子创临",
	4: "终末祷铸",
	5: "特典",
}
const ROLE_VERSION_ORDER: Array[int] = [1, 2, 3, 4, 5]


## 版本号 → 位掩码（0＝未定义，返回 0）
static func role_version_bit(version: int) -> int:
	if version <= 0:
		return 0
	return 1 << version


## 版本位掩码 → 中文名串（按固定顺序，用「+」连接）
static func role_versions_text(mask: int) -> String:
	var 名表: Array[String] = []
	for v: int in ROLE_VERSION_ORDER:
		if (mask & role_version_bit(v)) != 0:
			名表.append(str(ROLE_VERSION_NAMES.get(v, "版本%d" % v)))
	return "+".join(名表)

