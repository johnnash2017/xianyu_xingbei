## 该角色额外视为「自己会」的独有技（没有配置就返回空数组）
static func 借用独有技(角色号: int) -> Array[int]:
	var out: Array[int] = []
	var 项: Variant = 角色借用独有技.get(角色号, null)
	if 项 is Dictionary:
		for 借用号: Variant in (项.get("技能", []) as Array):
			out.append(int(借用号))
	return out


## 该角色借用的独有技在角色说明里是否置灰（默认不置灰）
static func 借用独有技置灰(角色号: int) -> bool:
	var 项: Variant = 角色借用独有技.get(角色号, null)
	if 项 is Dictionary:
		return bool(项.get("说明置灰", false))
	return false


