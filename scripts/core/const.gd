# ============================================================
# 技能名与分类（全部取自设计表「技能表」，技能号就是 技能表#N 的 N）
# ============================================================
## 技能名。名字里若写了词缀关键字会换成图标（见 词缀文本）——只在支持 BBCode 的富文本里显示才有意义。
## 末尾 strip_edges：token 正好落在整段首尾时不保留空白（句中仍严格前后加空格）。
static func skill_name(skill_id: int) -> String:
	var row: Array = 技能行(skill_id)
	if row.is_empty():
		# 内部询问号（不占技能表行）在按钮 / 日志上的显示名，没配才退回「技能N」
		return str(内部询问显示名.get(skill_id, "技能%d" % skill_id))
	return 词缀文本(技能文本数字空格(str(row[_技能列("技能名")]).strip_edges())).strip_edges()


## 技能表「说明说明名」列：只用于角色悬停说明、以及技能栏按钮上的技能名；
## 日志、提示条、单个技能悬停说明等其他地方仍用 skill_name()。
## 该列为空时回退到「技能名」列，避免新列漏填时按钮变成空白。
static func skill_desc_name(skill_id: int) -> String:
	var row: Array = 技能行(母技能号(skill_id))
	if row.is_empty():
		return skill_name(skill_id)
	var 名: String = str(row[_技能列("说明说明名")]).strip_edges()
	if 名 == "":
		return skill_name(skill_id)
	return 词缀文本(技能文本数字空格(名)).strip_edges()


## 技能表「说明」列的正文（技能按钮的悬停说明用）；查不到返回空串
static func skill_desc(skill_id: int) -> String:
	var row: Array = 技能行(母技能号(skill_id))
	if row.is_empty():
		return ""
	# 说明里写的词缀关键字（如「【治疗】」）换成图标，见 词缀文本。
	# 数字空格要在词缀文本之前做：词缀文本会把【治疗】等换成带尺寸的 [img=20x20]，
	# 先加空格再换图标，才不会把图标标签里的数字也拆开。
	# 末尾 strip_edges：token 正好落在整段首尾时不保留空白（句中仍严格前后加空格）。
	return 词缀文本(技能文本数字空格(str(row[_技能列("说明")]).strip_edges())).strip_edges()


## 技能名 / 说明 / 提示里数字类文本的前后空格统一在这里做。
## 匹配顺序（不能乱）：
##   0. BBCode 标签、{占位符} —— 整段保护，不往里面加空格
##   1. 比较词短语：X最高为2、最多3名、每项最少为2 —— 先吃掉，只给数字加空格，词和变量不动
##   2. 比较表达式：X>1、X<4、<X+2、<4 —— 先于公式，避免 X+2>3 只匹配到公式
##   3. 公式：X+Y-3、X+2、2+X、+(X-2)、+X、-X —— 整体不拆，只在最外层加空格
##   4. 范围：1~3、0-2 —— 整体不拆（0-2 也会被公式先吃掉，结果相同）
##   5. 独立变量：X、Y、X,Y
##   6. 带符号数字：+1、-1
##   7. 普通数字：3
## 严格按「前后各一个空格」处理（标点、括号旁也照加）；连续空格压成一个。
## BBCode 标签与 {占位符} 整段保护，不往里面加空格。
static func 技能文本数字空格(原文案: String) -> String:
	if 原文案.is_empty():
		return 原文案
	if _技能文本数字空格正则 == null:
		_技能文本数字空格正则 = RegEx.new()
		var 模式: String = (
			"(?<protect>\\[[^\\]]*\\]|\\{[^}]*\\})"
			+ "|(?<cmpword>[XY]?(?:最高为|最高到|不少于|不小于|不超过|大于|小于|高于|低于|最多|最少为|至少|至多|不足)\\s*(?<cmpword_num>[0-9]+))"
			+ "|(?<cmp>(?:[XY0-9]+(?:[+\\-][XY0-9]+)*)?[<>≤≥]=?\\s*(?:[XY0-9]+(?:[+\\-][XY0-9]+)*))"
			+ "|(?<formula_paren>[+\\-][（(][XY0-9]+(?:[+\\-][XY0-9]+)+[）)])"
			+ "|(?<formula>[XY0-9]+(?:[+\\-][XY0-9]+)+)"
			+ "|(?<range>[0-9]+\\s*[~～]\\s*[0-9]+)"
			+ "|(?<signvar>[+\\-][XY])"
			+ "|(?<var>[XY](?:\\s*,\\s*[XY])*)"
			+ "|(?<signed>[+\\-][0-9]+)"
			+ "|(?<num>[0-9]+)"
		)
		_技能文本数字空格正则.compile(模式)
		_技能文本连续空格正则 = RegEx.new()
		_技能文本连续空格正则.compile("[ \\t]{2,}")
	var 出: String = ""
	var 上次: int = 0
	for m: RegExMatch in _技能文本数字空格正则.search_all(原文案):
		var 起: int = m.get_start()
		if 起 > 上次:
			出 += 原文案.substr(上次, 起 - 上次)
		var 原文: String = m.get_string()
		if m.get_start("protect") >= 0:
			# BBCode / 占位符整段原样保留
			出 += 原文
		elif m.get_start("cmpword") >= 0:
			# 比较词短语：只给数字加空格，前面的词和变量（如 X最高为）保持原样
			var 数: String = m.get_string("cmpword_num")
			var 前缀: String = 原文.substr(0, 原文.length() - 数.length()).strip_edges()
			出 += 前缀 + " " + 数 + " "
		else:
			出 += " " + 原文 + " "
		上次 = m.get_end()
	if 上次 < 原文案.length():
		出 += 原文案.substr(上次)
	return _技能文本连续空格正则.sub(出, " ", true)


static var _技能文本数字空格正则: RegEx = null
static var _技能文本连续空格正则: RegEx = null


## 技能的大类标签（大类·类型，如「独有技·响应」）；技能表里查不到就返回空串
static func skill_tag(skill_id: int) -> String:
	var row: Array = 技能行(母技能号(skill_id))
	if row.is_empty():
		return ""
	var BroadCategory: String = str(row[_技能列("大类")]).strip_edges()
	# 表里普通技写的是「普通」，界面上补回「技」字，与独有技/专属技/必杀技一致
	if BroadCategory == "普通":
		BroadCategory = "普通技"
	var 类型: String = str(row[_技能列("类型")]).strip_edges()
	if BroadCategory == "":
		return 类型
	if 类型 == "":
		return BroadCategory
	return "%s·%s" % [BroadCategory, 类型]


