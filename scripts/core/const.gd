# ============================================================
# 技能名与分类（全部取自设计表「技能表」，技能号就是 技能表#N 的 N）
# ============================================================
## 技能名。名字里若写了词缀关键字会换成图标（见 词缀文本）——只在支持 BBCode 的富文本里显示才有意义
static func skill_name(skill_id: int) -> String:
	var row: Array = 技能行(skill_id)
	if row.is_empty():
		return "技能%d" % skill_id
	return 词缀文本(str(row[_技能列("技能名")]).strip_edges())


## 技能表「说明」列的正文（技能按钮的悬停说明用）；查不到返回空串
static func skill_desc(skill_id: int) -> String:
	var row: Array = 技能行(skill_id)
	if row.is_empty():
		return ""
	# 说明里写的词缀关键字（如「【治疗】」）换成图标，见 词缀文本
	return 词缀文本(str(row[_技能列("说明")]).strip_edges())


## 技能的分类标签（派系·类型，如「独有技·响应」）；技能表里查不到就返回空串
static func skill_tag(skill_id: int) -> String:
	var row: Array = 技能行(skill_id)
	if row.is_empty():
		return ""
	var 派系: String = str(row[_技能列("派系")]).strip_edges()
	# 表里普通技写的是「普通」，界面上补回「技」字，与独有技/专属技/必杀技一致
	if 派系 == "普通":
		派系 = "普通技"
	var 类型: String = str(row[_技能列("类型")]).strip_edges()
	if 派系 == "":
		return 类型
	if 类型 == "":
		return 派系
	return "%s·%s" % [派系, 类型]


## 技能表「类型」列（响应 / 启动 / 被动 / 法术…）；技能表里查不到就返回空串
static func skill_type(skill_id: int) -> String:
	var row: Array = 技能行(skill_id)
	if row.is_empty():
		return ""
	return str(row[_技能列("类型")]).strip_edges()


## ---- 文本宽度估算与截断（准备室座位名、战斗面板玩家名共用）----
## 按显示宽度把文字截断：超出可用宽就用「…」收尾。宽度是估的 —— 汉字 / 全角按 1.05 个字宽、
## ASCII 按 0.62 个字宽，不去量字体：该字体对中文的测量偏小，照它截往往截不够而溢出。
## 宁可少显示一个字，也不让文字换行或顶出框。
static func 截断文字(文本: String, 可用宽: float, 字号: int) -> String:
	if _估宽(文本, 字号) <= 可用宽:
		return 文本
	var 结果: String = ""
	var 宽: float = 0.0
	var 省略宽: float = _字宽("…", 字号)
	for 字: String in 文本:
		var 单字宽: float = _字宽(字, 字号)
		if 宽 + 单字宽 + 省略宽 > 可用宽:
			break
		宽 += 单字宽
		结果 += 字
	return 结果 + "…"


## 估一整串文字的显示宽度（见 截断文字）
static func _估宽(文本: String, 字号: int) -> float:
	var 宽: float = 0.0
	for 字: String in 文本:
		宽 += _字宽(字, 字号)
	return 宽


## 估单个字符的显示宽度：ASCII 约 0.62 个字宽，其余（汉字 / 全角）约 1.05 个字宽
static func _字宽(字: String, 字号: int) -> float:
	return float(字号) * (0.62 if 字.unicode_at(0) < 128 else 1.05)


## 技能类型 → 标色（技能说明里【类型】的颜色，技能按钮底色也用它）
const 技能类型颜色: Dictionary = {
	"被动": Color(0.29, 0.62, 1.0),    # 蓝 #4a9eff
	"响应": Color(0.54, 0.31, 0.87),   # 深紫 #8a4fdd
	"法术": Color(1.0, 0.35, 0.82),    # 洋红 #ff5ad2
	"启动": Color(1.0, 0.67, 0.25),    # 橙 #ffab40
}


## 技能类型对应的标色；未知类型返回白色（不着色）
static func skill_type_color(skill_id: int) -> Color:
	return 技能类型颜色.get(skill_type(skill_id), Color.WHITE)


## 技能表的 id 是名字型（如「技能#地之封印」）；脚本判断用的技能号另存在「脚本号」列，
## 下面两个函数负责两边互查：技能 id → 技能号、技能号 → 技能行。
static func 技能号(技能id: String) -> int:
	var row: Array = 数据表格.技能表.get(技能id.strip_edges(), [])
	if row.is_empty():
		return 0
	return int(row[_技能列("脚本号")])


## 技能号 → 技能表那一行（首次访问时按「脚本号」列建索引）；查不到返回空数组
static func 技能行(skill_id: int) -> Array:
	if _技能号到行.is_empty():
		for key: String in 数据表格.技能表.keys():
			var row: Array = 数据表格.技能表[key]
			var 号: int = int(row[_技能列("脚本号")])
			if 号 != 0:
				_技能号到行[号] = row
	return _技能号到行.get(skill_id, [])


## 技能号 → 技能行 的索引（懒建一次；技能表是启动时生成的静态数据，不会中途变）
static var _技能号到行: Dictionary = {}


static func _技能列(字段: String) -> int:
	return int(数据表格.表元数据["技能表"]["列索引"][字段])


## 技能表「提示」列（list(String)）：这个技能要说给玩家听的文案，按需要排成多条。
## 不区分「问别人」还是「问自己」——读第几条、当什么用，由角色脚本自己决定（读哪个下标就是哪条）。
## 文案支持占位符 {src} = 发起者称号、{dst} = 收牌人称号、{n} = 要交/弃的张数；
## 表里没配（或该行没这一列）就返回空数组，客户端退回默认文案（「是否发动【X】？」）。
static func 技能提示列表(skill_id: int) -> Array[String]:
	var 列索引: Dictionary = 数据表格.表元数据["技能表"]["列索引"]
	var 列: int = int(列索引.get("提示", -1))
	if 列 < 0:
		return []
	var row: Array = 技能行(skill_id)
	if row.size() <= 列:
		return []
	var 格子: Variant = row[列]
	if not (格子 is Array):
		return []
	var out: Array[String] = []
	for 元素: Variant in (格子 as Array):
		var 文本: String = _提示元素文本(元素)
		if not 文本.is_empty():
			out.append(文本)
	return out


## 「提示」列的一项转成字符串：导表把 list(String) 的每项生成成「单元素数组」，这里取回那一个串
static func _提示元素文本(元素: Variant) -> String:
	if 元素 is Array and not (元素 as Array).is_empty():
		return str((元素 as Array)[0]).strip_edges()
	return str(元素).strip_edges()


## 取「提示」列的第 序号 条（从 0 起）并填好占位符；没配或序号越界就返回空串。
## 占位符：{src}=发起者称号、{dst}=收牌人称号、{n}（＝{n1}）=张数；
## 一条文案要填多个值时，其余数字写 {n2}/{n3}/…、其余文本写 {s1}/{s2}/…，
## 具体值由调用方用 额外 传入（键就是占位符名，如 {"n2": 5, "s1": "火之茧"}）。
static func 提示文本(skill_id: int, 序号: int, 发起者: String, 张数: int, 收牌人: String = "",
		额外: Dictionary = {}) -> String:
	var 列表: Array[String] = 技能提示列表(skill_id)
	if 序号 < 0 or 序号 >= 列表.size():
		return ""
	var 文本: String = 列表[序号]
	文本 = 文本.replace("{src}", 发起者)
	文本 = 文本.replace("{dst}", 收牌人)
	文本 = 文本.replace("{n}", str(张数))
	文本 = 文本.replace("{n1}", str(张数))
	for 键: Variant in 额外:
		文本 = 文本.replace("{%s}" % str(键), str(额外[键]))
	return 文本


# ============================================================
# 词缀图标（取自设计表「词缀表」）
# ============================================================
## 把文本里出现的词缀关键字（如「【治疗】」）按词缀表「替换为」列处理：
## 不变＝保留原文、空＝删掉、图标＝换成图标（尺寸取「图标尺寸」列）。
## 只给支持 BBCode 的富文本用（技能说明提示框 / 战斗日志 / 头像提示等）；
## 普通 Label 不认 BBCode，会把 [img] 原样画出来，别往那儿送。
static func 词缀文本(文: String) -> String:
	if 文.is_empty():
		return 文
	for 规则: Array in _词缀规则表():
		var 关键字: String = str(规则[0])
		if 文.contains(关键字):
			文 = 文.replace(关键字, str(规则[1]))
	return 文


## 词缀表 → 替换规则（懒建一次）：[[关键字, 替换成的文本], …]
## 「不变」的条目不入表（原文保持不动），「空」替换成空串，其余按图标串
static var _词缀规则: Array = []

static func _词缀规则表() -> Array:
	if not _词缀规则.is_empty():
		return _词缀规则
	var 列索引: Dictionary = 数据表格.表元数据["词缀"]["列索引"]
	var 键列: int = int(列索引["关键字"])
	var 式列: int = int(列索引["替换为"])
	var 径列: int = int(列索引["图标路径"])
	var 寸列: int = int(列索引["图标尺寸"])
	for key: String in 数据表格.词缀.keys():
		var row: Array = 数据表格.词缀[key]
		if row.size() <= maxi(键列, maxi(式列, maxi(径列, 寸列))):
			continue
		var 关键字: String = str(row[键列]).strip_edges()
		if 关键字.is_empty():
			continue
		var 模式: int = int(row[式列])
		if 模式 == 数据表格.词缀_替换为.不变:
			continue
		var 换成: String = ""
		if 模式 == 数据表格.词缀_替换为.图标:
			var 路径: String = str(row[径列]).strip_edges()
			if 路径.is_empty():
				continue
			var 尺寸: Vector2i = _词缀尺寸(row[寸列])
			换成 = "[img=%dx%d]%s[/img]" % [尺寸.x, 尺寸.y, 路径]
		_词缀规则.append([关键字, 换成])
	return _词缀规则


## 「图标尺寸」列的类型是 list(float,float)，导表后形如 [[32, 32]]（每项外还包一层）→ Vector2i；
## 读不出来就按 32×32 画
static func _词缀尺寸(格子: Variant) -> Vector2i:
	var 对: Array = []
	if 格子 is Array:
		对 = 格子
	if not 对.is_empty() and 对[0] is Array:
		对 = 对[0] as Array
	if 对.size() >= 2:
		return Vector2i(int(float(对[0])), int(float(对[1])))
	return Vector2i(32, 32)


## 日志/提示用的技能全称：「【独有技·响应】疾风技」；查不到分类就退回「【疾风技】」
static func skill_title(skill_id: int) -> String:
	var 标签: String = skill_tag(skill_id)
	if 标签 == "":
		return "【%s】" % skill_name(skill_id)
	return "【%s】%s" % [标签, skill_name(skill_id)]


## 元素字符串 → 枚举值
static func element_from_string(s: String) -> int:
	match s:
		"wind": return CardElement.Wind
		"water": return CardElement.Water
		"fire": return CardElement.Fire
		"earth": return CardElement.Earth
		"thunder": return CardElement.Thunder
		"light": return CardElement.Light
		"darkness": return CardElement.Darkness
	return 0


## 元素枚举值 → 中文字符串
static func element_to_chinese(e: int) -> String:
	match e:
		CardElement.Wind: return "风"
		CardElement.Water: return "水"
		CardElement.Fire: return "火"
		CardElement.Earth: return "地"
		CardElement.Thunder: return "雷"
		CardElement.Light: return "光"
		CardElement.Darkness: return "暗"
	return "?"


## 命格字符串 → 枚举值
static func property_from_string(s: String) -> int:
	match s:
		"血": return CardProperty.Blood
		"技": return CardProperty.Martial
		"幻": return CardProperty.Phantom
		"咏": return CardProperty.Cast
		"圣": return CardProperty.Holy
	return 0


