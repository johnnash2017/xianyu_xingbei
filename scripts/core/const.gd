## 目标现有手牌少于 3 张、且手牌上限高于 5 时 5 点，否则 3 点。
static func 灵魂震爆伤害(手牌数: int, 手牌上限: int) -> int:
	if 手牌数 < 3 and 手牌上限 > 5:
		return 5
	return 3


