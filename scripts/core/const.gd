## 该角色此刻有没有【魔弹掌控】（常驻，或「临时掌控来源」正好是本次额外行动的 cause）
static func 魔弹掌控(role_id: int, 额外行动来源: int = 0) -> bool:
	if 角色特性值(role_id, "魔弹掌控") == true:
		return true
	var 来源值: Variant = 角色特性值(role_id, "临时掌控来源")
	var 来源: int = int(来源值) if 来源值 is int else 0
	return 来源 > 0 and 额外行动来源 == 来源


