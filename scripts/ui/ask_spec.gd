class_name 询问规格
extends RefCounted
## 一次询问的全部内容（问题清单见 项目文档/技能交互层统合计划.md）。
##
## 「询问」＝服务端问玩家「这一步怎么选」：轮到你行动、应战、是否发动某技能、
## 额外行动挑一份、以及纯本地的多步选择。以前这些内容散在 battle_mobile 的
## `_skill_*` / `_need_*` / `_二级选项` / `_额外*` 二十多个成员变量里，
## 每个入口各写一份、判定也各写一份；本类把它们收成一个对象。
##
## 约定：
##  * **只有数据，不碰界面、不碰 Data**：判定规则（可点牌 / 可点目标 / 可确认）
##    放在调用方，读本对象即可，不要在类里 get_node / Data.get_card。
##  * **规格里不存技能号参与判定**：技能号只用来查文案、播报、头像提示。
##  * 字段名与现有中文标识符保持一致，迁移期两边能一一对上，便于逐条核对。

## 询问种类。
## 名字用「类别」是为了和下面的成员变量 `种类` 区分开：同一脚本里枚举名与变量名
## 不能重名（会报重复声明），两个名字并存时读起来也更清楚。
enum 类别 {
	无 = 0,      ## 空闲
	行动 = 1,    ## 轮到你行动：出牌 / 技能 / 特殊行动
	应答 = 2,    ## 应战 / 弃牌 / 抵挡 / 魔弹传递 / 虚弱
	技能 = 3,    ## 是否发动某技能（可带选项）
	额外 = 4,    ## 额外行动：在几份行动里挑一份
	本地 = 5,    ## 纯本地多步（特殊行动选星石、提炼方式等），不经服务端
}

# ---------------- 这次询问是什么 ----------------
## 询问种类（上面的 类别）
var 种类: int = 类别.无
## 该由谁回答（-1＝还没定）
var 发起人: int = -1
## 说话用的技能号：文案 / 技能名 / 头像提示按它查（0＝通用行动或纯应答）
var 说话技能号: int = 0
## 应答类型（GConst.RespondType；0＝不适用）
var 应答号: int = 0

# ---------------- 选牌 ----------------
## 可选牌从哪来（GConst.CardSource：手牌 / 盖牌 / 两者 / 场上基础效果 / 手牌+基础效果）
var 选牌来源: int = GConst.CardSource.Hand
## 至少要选几张
var 需牌: int = 0
## 最多能选几张（≥ 需牌；等于需牌表示"刚好这么多"）
var 最多牌: int = 0
## 只能点这几张（牌面；空＝不限制）
var 牌白名单: Array[int] = []
## 选牌规则（""＝不限 / "same" / "diff" / "magic" / "magic_cover" / "an_zhi" /
## "same_fate_pattern"）：迁移期先原样保留字符串，阶段 6 再换约束列表
var 选牌规则: String = ""
## 手牌 + 盖牌混选时，要求其中几张必须是盖牌（0＝不要求）
var 盖牌需数: int = 0
## 逐张选牌条件：第 1 张必须带该技能 / 第 2 张必须是该系（0＝不要求）
var 槽位技能: int = 0
var 槽位系别: int = 0
## 目标数上限随已选牌数变化的减数（0＝不适用）：上限 = 已选牌数 - 该值
var 目标上限减牌数: int = 0

# ---------------- 选目标 ----------------
## 至少要选几名角色（0＝这一步不选人）
var 需目标: int = 0
## 最多能选几名（≥ 需目标）
var 最多目标: int = 0
## 只能点这几名（空＝不限制）
var 目标白名单: Array[int] = []

# ---------------- 选项 ----------------
## 选项列表，每项一个 Dictionary。键沿用现有叫法：
##   值 / 文本 / 可用 / 说明 / 技能号 / 技能组 / 卡牌 / 元素 / 提示 / 不改提示 /
##   需牌 / 最多牌 / 需目标 / 最多目标 / 目标白名单 / 牌白 / 预览牌 / 选牌来源 / 需盖牌
## 「值」是这一项提交给服务端的数（原 args[0]），其余键只影响显示与放开多少选牌/选目标。
var 选项: Array[Dictionary] = []
## 服务端建议先选中的那一项下标（-1＝没有建议）
var 默认项: int = -1

# ---------------- 额外行动 ----------------
## 额外行动列表，每项一个 Dictionary：uid / 来源 / 放行 / 牌白名单 / 目标白名单 / 系别 / 命格。
## **顺序就是显示顺序**（引擎 `额外行动序列` 排好下发），客户端不排序、不重排。
var 额外行动: Array[Dictionary] = []

# ---------------- 展示 ----------------
## 只点亮给人看、不参与选择也不提交的角色（如【别烦我……】替她发动的队友）
var 高亮: Array[int] = []
## 目标已由服务端点名并锁死（「自动选目标」型），点头像改不了
var 锁定目标: bool = false

# ---------------- 提交 ----------------
## 能不能点「取消」放弃（false＝强制询问，如【水之神力】的交牌）
var 可取消: bool = true


## 全部恢复成「没有询问」。
## 每次收到新询问前调一次，避免上一条询问的选牌 / 选目标约束串到下一条。
## 以前这件事散在 `_on_command` 里二十来行重置语句，漏一行就是"上一条的规则残留"。
func 清空() -> void:
	种类 = 类别.无
	发起人 = -1
	说话技能号 = 0
	应答号 = 0
	选牌来源 = GConst.CardSource.Hand
	需牌 = 0
	最多牌 = 0
	牌白名单.clear()
	选牌规则 = ""
	盖牌需数 = 0
	槽位技能 = 0
	槽位系别 = 0
	目标上限减牌数 = 0
	需目标 = 0
	最多目标 = 0
	目标白名单.clear()
	选项.clear()
	默认项 = -1
	额外行动.clear()
	高亮.clear()
	锁定目标 = false
	可取消 = true


## 这一步要不要选牌（选了才有意义；false 时手牌整片置灰）
func 要选牌() -> bool:
	return 需牌 > 0 or 最多牌 > 0


## 这一步要不要点人（false 时头像整片点不动）
func 要选人() -> bool:
	return 需目标 > 0 or 最多目标 > 0


## 有没有选项要摆
func 有选项() -> bool:
	return not 选项.is_empty()


## 当前还点得动的选项有几项。
## 约定（见 技能维护约定「二级技能栏选项：完整下发，不可用只置灰」）：
## 选项永远完整下发，做不了的写 `可用 = false` 留在原地；技能本体只有在
## 「至少还有一项可用」时才允许发动 —— 不能只看选项非空。
func 可用选项数() -> int:
	var n: int = 0
	for 项: Dictionary in 选项:
		if bool(项.get("可用", true)):
			n += 1
	return n


## 按「值」找选项下标（找不到返回 -1）。选项值才是提交给服务端的数，不是下标。
func 选项下标按值(值: int) -> int:
	for i: int in range(选项.size()):
		if int((选项[i] as Dictionary).get("值", 0)) == 值:
			return i
	return -1
